# PiCar-X API authentication token.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
PX_API_TOKEN=your-32-byte-hex-token-here

# ── Ollama (cognition + persona chat) ────────────────────────────────
# Since #308 SPARK's Ollama tiers run on Ollama Cloud, not on a local daemon.
# `https://ollama.com` — NOT `https://api.ollama.com`, which 403s.
# Get a key at https://ollama.com/settings/keys and put it here (or export
# OLLAMA_API_KEY, which the `ollama` CLI also reads). OLLAMA_CLOUD_API_KEY is
# the repo's older name for the same credential and is still accepted.
OLLAMA_API_KEY=your-ollama-cloud-key-here
PX_OLLAMA_HOST=https://ollama.com
# Persona chat/rephrase model (GREMLIN/VIXEN, tool-chat, tool-chat-vixen,
# tool-voice-persona). This is `PX_CHAT_MODEL`; there is no PX_OLLAMA_MODEL.
PX_CHAT_MODEL=deepseek-v4.1-flash:cloud

# Shared hosted-cognition settings (reflection, public/Obi chat, post/blog QA).
# Set to a LOCAL http:// host to borrow a resident model from a LAN daemon
# instead — that is the only case where PX_M5_SPARK_MODEL=resident is legal.
# PX_M5_SPARK_HOST=https://ollama.com
PX_M5_SPARK_MODEL=deepseek-v4.1-flash:cloud
# PX_M5_SPARK_API_KEY=...        # overrides OLLAMA_API_KEY for this tier
# PX_M5_SPARK_TIMEOUT_S=60       # hosted tiers need more room than a warm LAN daemon

# Home Assistant — single host knob for the Pi→HA control plane (awareness
# fetches AND the announce-pipeline cast). mDNS is fine here; only the relay
# URL the Nest fetches audio from must be IP-based. Default: homeassistant.local.
# PX_HA_HOST=http://homeassistant.local:8123
# PX_HA_TOKEN=your-long-lived-ha-token

# VIXEN voice settings (espeak)
# PX_VIXEN_VOICE=en+f4
# PX_VIXEN_PITCH=72
# PX_VIXEN_RATE=135

# GREMLIN voice settings (espeak)
# PX_GREMLIN_VOICE=en+croak
# PX_GREMLIN_PITCH=20
# PX_GREMLIN_RATE=180
