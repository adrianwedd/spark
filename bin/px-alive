#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/px-env"

# Ignore SIGUSR1 across the exec, until Python arms its own handler.
#
# Belt-and-braces, not a fix for an observed failure. 2e875e5c already closed
# the failure we actually saw (status=10/USR1 during the lease park: 17 kills
# in the 7 days before it deployed at 14:20 on 2026-08-16, zero in the 46
# restarts after). What it cannot cover is everything *before* main() runs: the
# program arrives on stdin as a heredoc, so Python reads ~1000 lines off a pipe,
# compiles them and runs argparse before reaching signal.signal(). A yield
# landing in there would still hit Python's default SIGUSR1 disposition and
# terminate the daemon. No instance of that has been observed — the window is
# just narrow, not closed.
#
# SIG_IGN survives exec (handlers do not — they reset to default), so Python
# inherits it and holds it until signal.signal() replaces it. A yield lost in
# this window is correctly lost: pre-main px-alive holds no Picarx handle, so
# there is nothing to yield. Must be set before the exec — this shell is gone
# after it.
trap '' USR1

# Use system python3 explicitly — the venv has include-system-site-packages=false
# so the venv python3 cannot see robot_hat/picarx which live in system site-packages.
exec /usr/bin/python3 - "$@" <<'PY'
"""Idle-alive daemon: keeps the robot looking alive with organic servo motion.

Behaviours (no wheels):
  - Face tracking: when Vilib detects a face, proportional pan/tilt to follow it.
  - Gaze drift: when no face, pick a new random look direction every 10-25 s.
  - Slow scan:  every 3-8 min, sweep pan left→right (idle scanning).
  - Proximity:  if ultrasonic < threshold for 3 s, turn to face nearest object.

Run with sudo (needs picarx). Writes PID file; handles SIGTERM cleanly.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import math
import os
import random
import signal
import socket
import sys
import tempfile
import time
from pathlib import Path

LOG_DIR  = Path(os.environ.get("LOG_DIR",  Path.cwd() / "logs"))
LOG_FILE = Path(os.environ.get("PX_LOG_FILE", LOG_DIR / "px-alive.log"))
PID_FILE = Path(os.environ.get("PX_ALIVE_PID", LOG_DIR / "px-alive.pid"))

GAZE_MIN_S        = 20
GAZE_MAX_S        = 50
GAZE_MIN_NIGHT_S  = 90    # much slower gaze at night — Obi asleep, no audience
GAZE_MAX_NIGHT_S  = 240
SCAN_MIN_S        = 180
SCAN_MAX_S        = 480
PROX_THRESH       = 35.0  # cm
PROX_HOLD_S       = 3.0   # seconds consistently close before reacting
PROX_REACT_COOL_S = 300.0 # min seconds between proximity reacts (pan changes sweep sonar)
PROX_CHECK_S      = 5.0   # how often to actually open Picarx for sonar
OBI_DAY_START     = 7     # hour (Hobart) — Obi's waking hours
OBI_DAY_END       = 20    # hour (Hobart)
PAN_RANGE    = (-65, 65)
TILT_RANGE   = (-15, 35)
EASE_SPEED   = 5      # steps per second (lower = fewer I2C writes, less servo jitter)

# Face tracking
FACE_TRACK_GAIN_PAN  = 0.15   # proportional gain for pan (higher = faster response)
FACE_TRACK_GAIN_TILT = 0.12   # proportional gain for tilt
FACE_FRAME_W         = 640    # Vilib camera frame width
FACE_FRAME_H         = 480    # Vilib camera frame height
FACE_DEADZONE        = 40     # pixels from center before tracking kicks in
FACE_LOST_TIMEOUT    = 3.0    # seconds without face before returning to gaze drift

# Emotional servo coordination: mood → body language
PROJECT_ROOT = Path(os.environ.get("PROJECT_ROOT", Path.cwd()))
STATE_DIR    = Path(os.environ.get("PX_STATE_DIR", PROJECT_ROOT / "state"))

try:
    from pxh import health as _health
except ImportError:                                   # pxh not on PYTHONPATH
    class _health:                                    # no-op shim
        record_success = staticmethod(lambda *a, **k: None)
        record_failure = staticmethod(lambda *a, **k: None)

# The loop ticks twice a second; coalesce successes so health reporting doesn't
# fsync the SD card 172,800 times a day.
HEALTH_INTERVAL_S = 60

MOOD_FILE       = STATE_DIR / "mood.json"
SESSION_FILE    = STATE_DIR / "session.json"
SONAR_LIVE_FILE = STATE_DIR / "sonar_live.json"
BATTERY_FILE    = STATE_DIR / "battery.json"
FRIGATE_FILE = STATE_DIR / "frigate_presence.json"
FRIGATE_STALE_S = 300   # ignore frigate_presence.json if older than this
MOOD_CHECK_S = 10    # how often to read mood file
SPARK_GREET_COOLDOWN_S = 120   # minimum seconds between SPARK proximity greetings

# How often the parked loop re-checks a foreign GPIO lease. Must stay well under
# WatchdogSec=15 so the heartbeat keeps flowing while we wait.
LEASE_RECHECK_S = 2.0

# Target spacing between heartbeats during a long blocking servo motion. Well
# under WatchdogSec=15, and cheap now the write lands on tmpfs.
HEARTBEAT_EVERY_S = 2.0

# The heartbeat is disposable liveness state and does NOT belong on the SD card
# — see pxh/runtime_paths.py for the measurements that moved it to tmpfs. The
# location is shared with pxh.api (the reader) so the two cannot drift apart.
try:
    from pxh.runtime_paths import resolve_heartbeat_write_dir
    HEARTBEAT_DIR = resolve_heartbeat_write_dir(STATE_DIR)
except ImportError:                                   # pxh not on PYTHONPATH
    HEARTBEAT_DIR = STATE_DIR

ALIVE_HEARTBEAT_FILE = HEARTBEAT_DIR / "alive_heartbeat.json"

MOOD_BEHAVIOR = {
    "excited":       {"gaze_min": 5,  "gaze_max": 12, "tilt_bias": 10},
    "playful":       {"gaze_min": 6,  "gaze_max": 15, "tilt_bias": 5},
    "mischievous":   {"gaze_min": 6,  "gaze_max": 14, "tilt_bias": 8},
    "curious":       {"gaze_min": 8,  "gaze_max": 18, "tilt_bias": 5},
    "alert":         {"gaze_min": 5,  "gaze_max": 10, "tilt_bias": 0},
    "content":       {"gaze_min": 10, "gaze_max": 25, "tilt_bias": 0},
    "peaceful":      {"gaze_min": 15, "gaze_max": 30, "tilt_bias": -5},
    "contemplative": {"gaze_min": 12, "gaze_max": 28, "tilt_bias": -5},
    "bored":         {"gaze_min": 20, "gaze_max": 40, "tilt_bias": -10},
    "lonely":        {"gaze_min": 15, "gaze_max": 35, "tilt_bias": -8},
    "grumpy":        {"gaze_min": 8,  "gaze_max": 20, "tilt_bias": -3},
    "anxious":       {"gaze_min": 4,  "gaze_max": 8,  "tilt_bias": 0},
}
def log(msg: str) -> None:
    ts = dt.datetime.now().isoformat(timespec="seconds")
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    ml = msg.lower()
    icon = "  "
    if any(k in ml for k in ("gaze drift", "sweep")):
        icon = "\U0001f440"  # 👀
    elif "proximity" in ml:
        icon = "\U0001f4e1"  # 📡
    elif "idle scan" in ml:
        icon = "\U0001f50d"  # 🔍
    elif any(k in ml for k in ("starting", "stopped", "acquired", "idle loop")):
        icon = "\U0001f527"  # 🔧
    elif any(k in ml for k in ("sigusr", "yield", "signal")):
        icon = "\U0001f6d1"  # 🛑
    elif any(k in ml for k in ("error", "failed", "i2c error")):
        icon = "\u26a1"      # ⚡
    elif any(k in ml for k in ("mood", "behavior")):
        icon = "\U0001f3ad"  # 🎭
    elif "greet" in ml:
        icon = "\U0001f44b"  # 👋
    line = f"{ts} {icon} {msg}"
    with LOG_FILE.open("a", encoding="utf-8") as f:
        f.write(line + "\n")
    print(line, flush=True)
    # Simple rotation: keep last half when file exceeds 5MB
    try:
        if LOG_FILE.stat().st_size > 5_000_000:
            lines = LOG_FILE.read_text(encoding="utf-8").splitlines()
            half = len(lines) // 2
            half_content = "\n".join(lines[half:]) + "\n"
            import tempfile as _tmpmod
            fd, tmp = _tmpmod.mkstemp(dir=str(LOG_FILE.parent), suffix=".tmp")
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(half_content)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, str(LOG_FILE))
    except Exception:
        pass


def _sd_notify(message: str) -> bool:
    """Send a systemd notification without requiring python-systemd."""
    address = os.environ.get("NOTIFY_SOCKET", "")
    if not address:
        return False
    if address.startswith("@"):
        address = "\0" + address[1:]
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as notify_socket:
            notify_socket.connect(address)
            notify_socket.sendall(message.encode("utf-8"))
        return True
    except OSError as exc:
        log(f"systemd notify failed: {exc}")
        return False


# --- systemd readiness ------------------------------------------------------
#
# Under Type=notify the WatchdogSec clock only starts once READY=1 arrives, so
# everything before that is governed by TimeoutStartSec instead. That split is
# the point: startup and steady state have genuinely different deadlines.
#
# A normal start acquires the Picarx handle in ~6s, but a start immediately
# after a yield_alive contends for I2C with the tool that just took GPIO and
# can block past 15s inside Picarx.__init__ — observed live, SIGABRTed mid-init
# having never reached the loop. Killing a daemon that is patiently waiting for
# hardware buys nothing: the watchdog exists to catch a *wedged loop*, and the
# loop has not started yet. Faking heartbeats through initialisation would
# "fix" it only by blinding the watchdog to the thing it is there to detect.
_ready = False

# How far each pre-READY heartbeat pushes out TimeoutStartSec. Must exceed the
# heartbeat spacing (HEARTBEAT_EVERY_S / LEASE_RECHECK_S) so the extensions
# overlap, and covers an unbounded park behind a foreign GPIO lease.
START_EXTEND_S = 30.0


def notify_ready(status: str) -> None:
    """Declare the daemon operational. Idempotent — the first call wins.

    Called only from states where px-alive is actually doing its job: holding
    the Picarx handle, or deliberately not holding it (on charger, in I2C
    backoff). From here on the 15s watchdog governs, strictly.
    """
    global _ready
    if _ready:
        return
    _ready = True
    _sd_notify(f"READY=1\nSTATUS={status}")
    log(f"systemd: ready ({status})")


_heartbeat_err_logged = False

# Yielding GPIO is module-level state, not idle_loop's, because the handler must
# be armed from the moment main() starts — before the lease park, which idle_loop
# is never reached from. Left inside idle_loop, SIGUSR1 kept Python's default
# disposition during the park and *terminated* the daemon: a tool calling
# yield_alive killed the very process the park was protecting. Parked we hold no
# Picarx handle, so there is nothing to yield and the correct answer is a no-op.
_yield_requested = False


def _on_yield(_sig, _frame) -> None:
    global _yield_requested
    _yield_requested = True


# --- watchdog margin telemetry ----------------------------------------------
#
# The loop stalls constantly and invisibly. Sampled on the live Pi over 34min:
# 41 in-process stalls (same PID, so not restarts), 5.07s min / 7.06s median /
# 14.93s max against WatchdogSec=15 — a 70ms margin, as the daemon's ordinary
# state rather than an exceptional event. Nothing in the journal distinguished
# that from a restart, which is how two confident and wrong root-cause theories
# got as far as they did.
#
# These observations are owned here and ride the existing heartbeat record at
# the existing cadence: no new writer, no new file, no tighter loop. health.py
# only interprets them.
#
# Everything is in-process and resets with the process, so these numbers can
# never mix a stall together with a restart gap — the distinction the sampler
# has to reconstruct from PIDs is structural here.
_hb_last_ts: float | None = None
_hb_last_mode = ""
_hb_gap_last_ms = 0.0
_hb_gap_max_ms = 0.0
_hb_gap_max_mode = ""
_hb_window_started_at: float | None = None
# A single extremum is a known-lossy summary of the measured spread, which is
# continuous and heavy-tailed rather than clustered. Coarse buckets cost one
# small dict and keep the shape.
_hb_gap_buckets: dict[str, int] = {}
_loop_last_ms = 0.0
_loop_max_ms = 0.0

# systemd exports this for Type=notify units with WatchdogSec set, so the
# margin is computed against the deadline actually in force rather than a
# constant duplicated from the unit file.
try:
    WATCHDOG_LIMIT_MS = int(os.environ.get("WATCHDOG_USEC", "0")) / 1000.0
except ValueError:
    WATCHDOG_LIMIT_MS = 0.0


def _gap_bucket(gap_ms: float) -> str:
    """2s buckets, saturating at 16s+ (past the watchdog, the exact value moot)."""
    seconds = int(gap_ms // 1000)
    if seconds >= 16:
        return "16s+"
    low = (seconds // 2) * 2
    return f"{low}-{low + 2}s"


def note_loop_duration(duration_s: float) -> None:
    """Record one top-of-loop-to-top-of-loop interval. Never raises."""
    global _loop_last_ms, _loop_max_ms
    _loop_last_ms = duration_s * 1000.0
    _loop_max_ms = max(_loop_max_ms, _loop_last_ms)


def _observe_beat(ts: float, mode: str) -> None:
    """Fold this beat into the window's timing observations."""
    global _hb_last_ts, _hb_gap_last_ms, _hb_gap_max_ms, _hb_gap_max_mode
    global _hb_window_started_at
    if _hb_window_started_at is None:
        _hb_window_started_at = ts
    if _hb_last_ts is not None and ts > _hb_last_ts:
        _hb_gap_last_ms = (ts - _hb_last_ts) * 1000.0
        bucket = _gap_bucket(_hb_gap_last_ms)
        _hb_gap_buckets[bucket] = _hb_gap_buckets.get(bucket, 0) + 1
        if _hb_gap_last_ms > _hb_gap_max_ms:
            _hb_gap_max_ms = _hb_gap_last_ms
            # The phase that was live when the loop went quiet is the mode of
            # the *earlier* beat: the stall follows it, it does not precede it.
            _hb_gap_max_mode = _hb_last_mode
    _hb_last_ts = ts


def reset_watchdog_window(now: float | None = None) -> None:
    """Start a fresh observation window.

    Extrema are windowed, never lifetime: a permanent max=14.93s stops being a
    signal the moment it stops moving.
    """
    global _hb_gap_max_ms, _hb_gap_max_mode, _hb_window_started_at, _loop_max_ms
    global _hb_gap_buckets, _hb_last_ts, _hb_gap_last_ms
    _hb_gap_max_ms = 0.0
    _hb_gap_max_mode = ""
    _loop_max_ms = 0.0
    _hb_gap_buckets = {}
    _hb_gap_last_ms = 0.0
    # Also drop the last-beat mark: leaving it set makes the first beat of the
    # new window measure a gap spanning the reset itself, which is not a stall.
    _hb_last_ts = None
    _hb_window_started_at = time.time() if now is None else now


def write_alive_heartbeat(mode: str, now: float | None = None) -> bool:
    """Atomically publish loop progress, then notify systemd's watchdog.

    The notification deliberately follows the durable write: systemd must not
    consider the loop healthy when its authoritative progress record is stale.
    """
    global _heartbeat_err_logged, _hb_last_mode
    ALIVE_HEARTBEAT_FILE.parent.mkdir(parents=True, exist_ok=True)
    ts = time.time() if now is None else now
    _observe_beat(ts, mode)
    record = {"ts": ts, "mode": mode}
    # Reporting must never be able to kill the daemon it reports on, so the
    # observations are attached defensively and the beat goes out regardless.
    try:
        record.update({
            "loop_duration_last_ms": round(_loop_last_ms, 1),
            "loop_duration_max_ms": round(_loop_max_ms, 1),
            "heartbeat_gap_last_ms": round(_hb_gap_last_ms, 1),
            "heartbeat_gap_max_ms": round(_hb_gap_max_ms, 1),
            "heartbeat_gap_max_mode": _hb_gap_max_mode,
            "heartbeat_gap_buckets": dict(_hb_gap_buckets),
            "window_started_at": _hb_window_started_at,
        })
        if WATCHDOG_LIMIT_MS > 0:
            record["watchdog_margin_min_ms"] = round(
                WATCHDOG_LIMIT_MS - _hb_gap_max_ms, 1
            )
    except Exception:  # pragma: no cover — telemetry is never load-bearing
        pass
    _hb_last_mode = mode
    payload = json.dumps(record)
    tmp_path = None
    try:
        fd, tmp_path = tempfile.mkstemp(
            dir=str(ALIVE_HEARTBEAT_FILE.parent), suffix=".tmp"
        )
        os.chmod(tmp_path, 0o644)
        with os.fdopen(fd, "w", encoding="utf-8") as heartbeat_file:
            heartbeat_file.write(payload)
            heartbeat_file.flush()
            os.fsync(heartbeat_file.fileno())
        os.replace(tmp_path, str(ALIVE_HEARTBEAT_FILE))
        _heartbeat_err_logged = False
        if _ready:
            _sd_notify("WATCHDOG=1")
        else:
            # Pre-READY the watchdog is not yet armed; what can kill us is
            # TimeoutStartSec. Push it out on every beat so a slow acquisition
            # (or a long lease park) survives, while still proving liveness.
            _sd_notify(
                "WATCHDOG=1\nEXTEND_TIMEOUT_USEC=%d" % int(START_EXTEND_S * 1_000_000)
            )
        return True
    except OSError as exc:
        if not _heartbeat_err_logged:
            log(f"alive heartbeat write failed: {exc}")
            _heartbeat_err_logged = True
        if tmp_path is not None:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass
        return False


def _pan_from_frigate(presence: dict | None) -> int:
    """Pan angle (degrees) toward Frigate-detected person. Returns 0 if no detection.
    x_center 0=left 1=right, 0.5=centre. Clamped to +-40 degrees.
    PiCarX pan convention: positive=left, negative=right (confirmed from face-tracking code).
    """
    if not isinstance(presence, dict) or not presence.get("person_present"):
        return 0
    x = presence.get("x_center")
    if not isinstance(x, (int, float)):
        return 0
    return max(-40, min(40, int((0.5 - x) * 80)))


def ease(px, from_pan: int, from_tilt: int, to_pan: int, to_tilt: int,
         duration: float, mode: str = "running") -> None:
    steps = max(2, int(duration * EASE_SPEED))
    # Servo motion is the one place the loop legitimately blocks for longer than
    # WatchdogSec. An idle scan sweep eases through ~17 targets plus a recentre —
    # over 30s of motion — and without a beat inside it systemd kills a perfectly
    # healthy daemon. Beat on entry and roughly every HEARTBEAT_EVERY_S after.
    steps_per_beat = (
        max(1, int(steps * HEARTBEAT_EVERY_S / duration)) if duration > 0 else 1
    )
    prev_pan, prev_tilt = from_pan, from_tilt
    for i in range(steps + 1):
        if i % steps_per_beat == 0:
            write_alive_heartbeat(mode)
        # Sine ease-in-out: smooth acceleration/deceleration
        t = 0.5 - 0.5 * math.cos(math.pi * i / steps)
        new_pan  = int(round(from_pan  + (to_pan  - from_pan)  * t))
        new_tilt = int(round(from_tilt + (to_tilt - from_tilt) * t))
        # Only write I2C when the angle actually changed — redundant writes
        # cause servo micro-jitter as the MCU briefly interrupts PWM
        if new_pan != prev_pan:
            px.set_cam_pan_angle(new_pan)
            prev_pan = new_pan
        if new_tilt != prev_tilt:
            px.set_cam_tilt_angle(new_tilt)
            prev_tilt = new_tilt
        if i < steps:
            time.sleep(duration / steps)


_charging_err_logged = False

def _is_charging() -> bool:
    """Check battery.json — True if robot is charging."""
    global _charging_err_logged
    try:
        data = json.loads(BATTERY_FILE.read_text(encoding="utf-8"))
        _charging_err_logged = False
        return bool(data.get("charging", False))
    except Exception as exc:
        if not _charging_err_logged:
            log(f"battery.json read failed: {exc}")
            _charging_err_logged = True
        return False


def read_session_persona() -> str:
    """Read persona from session.json without pxh (system python3, no venv)."""
    try:
        data = json.loads(SESSION_FILE.read_text(encoding="utf-8"))
        return str(data.get("persona", "")).lower().strip()
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return ""


import subprocess as _subprocess

def spark_greet(dry: bool) -> None:
    """Speak a soft SPARK proximity greeting via tool-voice."""
    import random as _random
    greetings = [
        "Hey. I'm here.",
        "Hello there.",
        "Hi. Good to see you.",
        "Hey.",
    ]
    text = _random.choice(greetings)
    tool_voice = PROJECT_ROOT / "bin" / "tool-voice"
    env = os.environ.copy()
    env["PX_TEXT"] = text
    env["PX_PERSONA"] = "spark"
    env["PX_VOICE_VARIANT"] = "en+m3"
    env["PX_VOICE_PITCH"] = "58"
    env["PX_VOICE_RATE"] = "120"
    if dry:
        env["PX_DRY"] = "1"
    try:
        _subprocess.run([str(tool_voice)], env=env, capture_output=True, check=False, timeout=8)
    except Exception:
        pass  # voice busy or timed out — greet silently skipped, px-alive keeps running


def make_px(force_reset: bool = False):
    """Create a Picarx instance, optionally skipping the MCU reset.

    The upstream Picarx.__init__() unconditionally calls reset_mcu() which
    pulses GPIO5 LOW→HIGH, wiping all MCU PWM registers and causing a
    visible servo shudder.  On normal yield_alive restarts the MCU is
    already running and doesn't need resetting — we monkey-patch reset_mcu
    to a no-op.  On I2C error recovery (force_reset=True) we keep the real
    reset to clear a potentially wedged MCU.
    """
    from picarx import Picarx
    import robot_hat.utils

    if force_reset:
        return Picarx()

    _orig = robot_hat.utils.reset_mcu
    robot_hat.utils.reset_mcu = lambda: None
    try:
        return Picarx()
    finally:
        robot_hat.utils.reset_mcu = _orig


def release_px(px) -> None:
    """Release ultrasonic GPIO handles without moving servos.

    The MCU holds PWM state autonomously over I2C — servos stay at their
    last commanded position after we release handles.  We intentionally
    skip px.close() because it calls Picarx.reset() which snaps all
    servos to calibration-center (the first half of the "shudder").
    """
    try:
        px.ultrasonic.close()
    except Exception:
        pass
    # Do NOT call px.close() — it centres servos via reset().
    # Servo PWM channels and I2C bus handles are released when the
    # process exits; the MCU keeps driving servos in the meantime.


def safe_distance() -> float | None:
    """Open Picarx briefly just to read sonar, then release. None on failure."""
    px = None
    try:
        px = make_px()
        d = px.get_distance()
        return float(d) if d and d > 0 else None
    except OSError:
        return None
    except Exception as exc:
        log(f"safe_distance unexpected: {exc}")
        return None
    finally:
        if px is not None:
            release_px(px)


def do_ease(from_pan: int, from_tilt: int, to_pan: int, to_tilt: int, duration: float) -> None:
    """Open Picarx, ease to target, then release."""
    px = None
    try:
        px = make_px()
        ease(px, from_pan, from_tilt, to_pan, to_tilt, duration, mode="ease_oneshot")
    finally:
        if px is not None:
            release_px(px)


I2C_BACKOFF_S = 30     # seconds to wait after an I2C failure before retrying


def start_face_detection(retries: int = 2) -> bool:
    """Start Vilib camera + face detection. Returns True if successful."""
    for attempt in range(retries + 1):
        try:
            from vilib import Vilib
            Vilib.camera_start(vflip=False, hflip=False)
            Vilib.face_detect_switch(True)
            log("face detection started (Vilib)")
            return True
        except Exception as exc:
            log(f"face detection attempt {attempt+1} failed: {exc}")
            # Camera may be held by a stale process — wait and retry
            try:
                from vilib import Vilib
                Vilib.camera_close()
            except Exception as exc2:
                log(f"camera close during retry failed: {exc2}")
            if attempt < retries:
                time.sleep(3)
    log("face detection unavailable — falling back to random gaze")
    return False


def stop_face_detection() -> None:
    """Stop Vilib camera."""
    try:
        from vilib import Vilib
        Vilib.camera_close()
    except Exception as exc:
        log(f"stop_face_detection cleanup failed: {exc}")


def get_face() -> tuple[int, int] | None:
    """Return (x, y) pixel coords of detected face, or None if no face."""
    try:
        from vilib import Vilib
        n = Vilib.detect_obj_parameter.get("human_n", 0)
        if n > 0:
            x = Vilib.detect_obj_parameter.get("human_x", FACE_FRAME_W // 2)
            y = Vilib.detect_obj_parameter.get("human_y", FACE_FRAME_H // 2)
            return (int(x), int(y))
    except (ImportError, OSError):
        pass  # expected if vilib unavailable
    except Exception as exc:
        log(f"get_face unexpected: {exc}")
    return None


def read_mood() -> dict:
    """Read mood.json written by px-mind. Returns behavior params or defaults."""
    try:
        if MOOD_FILE.exists():
            data = json.loads(MOOD_FILE.read_text(encoding="utf-8"))
            mood = data.get("mood", "content")
            behavior = MOOD_BEHAVIOR.get(mood, MOOD_BEHAVIOR["content"])
            return behavior
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        pass  # expected on missing/corrupt mood file
    except Exception as exc:
        log(f"read_mood unexpected: {exc}")
    return MOOD_BEHAVIOR["content"]


def idle_loop(args) -> None:
    cur_pan, cur_tilt = 0, 0
    _night_now = not (OBI_DAY_START <= dt.datetime.now().hour < OBI_DAY_END)
    next_gaze = time.monotonic() + random.uniform(
        GAZE_MIN_NIGHT_S if _night_now else GAZE_MIN_S,
        GAZE_MAX_NIGHT_S if _night_now else GAZE_MAX_S,
    )
    next_scan = time.monotonic() + random.uniform(SCAN_MIN_S, SCAN_MAX_S)
    next_prox = time.monotonic() + PROX_CHECK_S
    next_mood_check = time.monotonic() + MOOD_CHECK_S
    cur_mood_behavior = MOOD_BEHAVIOR["content"]
    prox_near_since: float | None = None
    prox_was_close: bool = True      # assume close on startup so first check doesn't fire on a static wall
    prox_last_react: float = 0.0     # monotonic time of last proximity react (cooldown guard)
    spark_last_greet: float = 0.0    # monotonic time of last SPARK greeting
    i2c_ok_after: float = 0.0  # monotonic time after which I2C retries are allowed
    face_tracking = not args.no_face
    face_active = False
    face_last_seen: float = 0.0  # monotonic time of last face detection

    # Start face detection if enabled
    if face_tracking:
        face_active = start_face_detection()

    # Keep a persistent Picarx instance to avoid GPIO pin leak on repeated
    # Picarx() construction (reset_mcu claims GPIO5 and close() doesn't
    # release it, causing "GPIO busy" on the next open).
    px = None

    _force_next_reset = False

    def get_px():
        nonlocal px, _force_next_reset
        if px is None:
            px = make_px(force_reset=_force_next_reset)
            log(f"acquired Picarx handle (reset={'hard' if _force_next_reset else 'skipped'})")
            _force_next_reset = False
            # The acquisition that just returned is the one that can overrun
            # WatchdogSec under I2C contention. Now that it has, the loop is
            # operational and the strict watchdog is the right instrument.
            notify_ready("holding Picarx handle")
        return px

    def drop_px(force_reset_on_reacquire: bool = False):
        nonlocal px, _force_next_reset
        if px is not None:
            release_px(px)
            px = None
        _force_next_reset = force_reset_on_reacquire

    log(f"idle loop started (persistent Picarx handle, sonar every {PROX_CHECK_S:.0f}s)")

    # systemd starts its watchdog when the service launches. Prove that Python
    # reached the loop setup before the startup sonar write below, whose fsync
    # can legitimately take several seconds on the Pi's SD card.
    write_alive_heartbeat("starting")

    # Write a startup heartbeat so px-mind doesn't see a stale file during the
    # Picarx acquisition window (takes ~5s), avoiding the tool-sonar fallback
    # that would immediately send SIGUSR1 and kill us before we do anything useful.
    try:
        import tempfile as _tmp_start
        _startup_data = json.dumps({"ts": time.time(), "distance_cm": None})
        _fd_s, _tmp_s = _tmp_start.mkstemp(dir=str(SONAR_LIVE_FILE.parent), suffix=".tmp")
        os.chmod(_tmp_s, 0o644)
        with os.fdopen(_fd_s, "w", encoding="utf-8") as _fs:
            _fs.write(_startup_data)
            _fs.flush()
            os.fsync(_fs.fileno())
        os.replace(_tmp_s, str(SONAR_LIVE_FILE))
    except Exception as _se:
        log(f"startup sonar_live.json write failed: {_se}")

    # A fresh window per idle_loop entry: the observations describe this run of
    # the loop, and a restart must not inherit the previous run's extrema.
    reset_watchdog_window()
    _loop_prev_tick = None

    try:
        while True:
            # Check yield flag — clean exit between iterations (not mid-I2C)
            if _yield_requested:
                log("SIGUSR1: tool needs GPIO — stopping so it can run")
                drop_px()
                stop_face_detection()
                sys.exit(0)

            now = time.monotonic()
            # Iteration-to-iteration wall time. Distinct from the heartbeat gap:
            # a long iteration that beats from inside ease() is healthy, whereas
            # a long gap is not — so the two must be observed separately or a
            # legitimate 30s scan sweep looks identical to a wedged I2C write.
            if _loop_prev_tick is not None:
                note_loop_duration(now - _loop_prev_tick)
            _loop_prev_tick = now
            is_night = not (OBI_DAY_START <= dt.datetime.now().hour < OBI_DAY_END)

            # Skip all hardware if in I2C backoff period
            if now < i2c_ok_after:
                # Backoff is a working state, not a failed start — on a bus that
                # never comes back the daemon would otherwise sit in `activating`
                # forever, waiting for an acquisition it is deliberately skipping.
                notify_ready("I2C backoff")
                write_alive_heartbeat("i2c_backoff")
                time.sleep(0.5)
                continue

            try:
                # --- Mood check (read px-mind's mood.json) ---
                if now >= next_mood_check:
                    next_mood_check = now + MOOD_CHECK_S
                    cur_mood_behavior = read_mood()

                # --- Charging check: freeze all servo motion while on charger ---
                if _is_charging():
                    # A robot parked on the charger at boot never opens Picarx,
                    # so readiness cannot wait on the handle here either.
                    notify_ready("on charger — servo motion frozen")
                    write_alive_heartbeat("charging")
                    time.sleep(2)
                    continue

                # Functional liveness is independent of sonar freshness. Publish
                # progress before hardware calls so a blocked call stops watchdog
                # notifications and is restarted by systemd.
                write_alive_heartbeat("running")

                # --- Proximity check (every PROX_CHECK_S — not every loop tick) ---
                if PROX_THRESH > 0 and now >= next_prox:
                    next_prox = now + PROX_CHECK_S
                    try:
                        d = get_px().get_distance()
                        dist = float(d) if d and d > 0 else None
                    except OSError:
                        dist = None
                    except Exception as exc:
                        log(f"sonar read unexpected: {exc}")
                        dist = None
                    try:
                        import tempfile as _tmp
                        _data = json.dumps({"ts": time.time(), "distance_cm": dist})
                        _fd, _tmp_path = _tmp.mkstemp(
                            dir=str(SONAR_LIVE_FILE.parent), suffix=".tmp"
                        )
                        os.chmod(_tmp_path, 0o644)  # world-readable: px-mind runs as pi, not root
                        with os.fdopen(_fd, "w", encoding="utf-8") as _f:
                            _f.write(_data)
                            _f.flush()
                            os.fsync(_f.fileno())
                        os.replace(_tmp_path, str(SONAR_LIVE_FILE))
                    except Exception as exc:
                        log(f"sonar_live.json write failed: {exc}")
                    is_close = dist is not None and dist < PROX_THRESH
                    if is_close:
                        # Only start the hold timer on a fresh approach (not when the
                        # obstacle was already close last check — avoids firing every
                        # 8s on a static wall or desk edge that's permanently nearby).
                        if prox_near_since is None and not prox_was_close:
                            prox_near_since = now
                        elif (prox_near_since is not None
                              and now - prox_near_since >= PROX_HOLD_S
                              and now - prox_last_react >= PROX_REACT_COOL_S
                              and not is_night):  # no servo movement or speech at night
                            try:
                                _fp = json.loads(FRIGATE_FILE.read_text())
                                _fp_ts = _fp.get("ts") if isinstance(_fp, dict) else None
                                if _fp_ts:
                                    _age = (dt.datetime.now(dt.timezone.utc) - dt.datetime.fromisoformat(_fp_ts)).total_seconds()
                                    if _age > FRIGATE_STALE_S:
                                        _fp = None
                            except (FileNotFoundError, json.JSONDecodeError, OSError, ValueError):
                                _fp = None
                            target_pan = _pan_from_frigate(_fp)
                            log(f"proximity react: {dist:.1f}cm — facing pan={target_pan}")
                            ease(get_px(), cur_pan, cur_tilt, target_pan, 5, 0.5,
                                 mode="ease_proximity")
                            cur_pan, cur_tilt = target_pan, 5
                            prox_near_since = None
                            prox_last_react = now
                            next_gaze = now + random.uniform(cur_mood_behavior.get("gaze_min", GAZE_MIN_S), cur_mood_behavior.get("gaze_max", GAZE_MAX_S))
                            # SPARK greeting — speak only when SPARK persona active + cooldown ok
                            if (read_session_persona() == "spark"
                                    and now - spark_last_greet >= SPARK_GREET_COOLDOWN_S):
                                spark_greet(args.dry_run)
                                spark_last_greet = now
                    else:
                        prox_near_since = None
                    prox_was_close = is_close

                # --- Face tracking (overrides gaze drift when a face is detected) ---
                face_tracked = False
                if face_active:
                    face = get_face()
                    if face is not None:
                        fx, fy = face
                        face_last_seen = now

                        # Error from center (pixels)
                        err_x = fx - FACE_FRAME_W // 2
                        err_y = fy - FACE_FRAME_H // 2

                        if abs(err_x) > FACE_DEADZONE or abs(err_y) > FACE_DEADZONE:
                            # Proportional adjustment (invert x: face left of frame → pan right)
                            new_pan = cur_pan - int(err_x * FACE_TRACK_GAIN_PAN)
                            new_tilt = cur_tilt - int(err_y * FACE_TRACK_GAIN_TILT)
                            new_pan = max(PAN_RANGE[0], min(PAN_RANGE[1], new_pan))
                            new_tilt = max(TILT_RANGE[0], min(TILT_RANGE[1], new_tilt))

                            if new_pan != cur_pan or new_tilt != cur_tilt:
                                p = get_px()
                                p.set_cam_pan_angle(new_pan)
                                p.set_cam_tilt_angle(new_tilt)
                                cur_pan, cur_tilt = new_pan, new_tilt

                        face_tracked = True
                        # Defer gaze/scan while tracking a face
                        next_gaze = now + random.uniform(cur_mood_behavior.get("gaze_min", GAZE_MIN_S), cur_mood_behavior.get("gaze_max", GAZE_MAX_S))
                        next_scan = now + random.uniform(SCAN_MIN_S, SCAN_MAX_S)

                    elif face_last_seen > 0 and (now - face_last_seen) < FACE_LOST_TIMEOUT:
                        # Recently lost face — hold position, don't drift yet
                        face_tracked = True

                # --- Slow idle scan (suppressed at night — looks broken when Obi is asleep) ---
                if not face_tracked and not is_night and now >= next_scan:
                    log("idle scan: sweeping pan")
                    angles = list(range(PAN_RANGE[0], PAN_RANGE[1] + 1, 15)) + \
                             list(range(PAN_RANGE[1], PAN_RANGE[0] - 1, -15))
                    p = get_px()
                    for a in angles:
                        if _yield_requested:
                            break
                        ease(p, cur_pan, cur_tilt, a, cur_tilt, 1.5, mode="scanning")
                        cur_pan = a
                        time.sleep(0.3)
                    ease(p, cur_pan, cur_tilt, 0, 0, 2.0, mode="scanning")
                    cur_pan, cur_tilt = 0, 0
                    log("idle scan: sweep complete")
                    next_scan = now + random.uniform(SCAN_MIN_S, SCAN_MAX_S)
                    next_gaze = now + random.uniform(cur_mood_behavior.get("gaze_min", GAZE_MIN_S), cur_mood_behavior.get("gaze_max", GAZE_MAX_S))
                elif not face_tracked and is_night and now >= next_scan:
                    # Reschedule without sweeping so the timer doesn't pile up
                    next_scan = now + random.uniform(SCAN_MIN_S, SCAN_MAX_S)

                # --- Gaze drift (only when not tracking a face) ---
                elif not face_tracked and now >= next_gaze:
                    if is_night:
                        # Night: freeze all servo movement — Obi is asleep
                        next_gaze = now + random.uniform(GAZE_MIN_NIGHT_S, GAZE_MAX_NIGHT_S)
                    else:
                        gaze_min = cur_mood_behavior.get("gaze_min", GAZE_MIN_S)
                        gaze_max = cur_mood_behavior.get("gaze_max", GAZE_MAX_S)
                        target_pan  = random.randint(*PAN_RANGE)
                        # Apply mood tilt bias (positive = head up/alert, negative = drooping)
                        tilt_bias = cur_mood_behavior.get("tilt_bias", 0)
                        tilt_lo = max(TILT_RANGE[0], TILT_RANGE[0] + tilt_bias)
                        tilt_hi = min(TILT_RANGE[1], TILT_RANGE[1] + tilt_bias)
                        if tilt_lo > tilt_hi:
                            tilt_lo, tilt_hi = tilt_hi, tilt_lo  # guard against inverted range
                        target_tilt = random.randint(tilt_lo, tilt_hi)
                        duration    = random.uniform(3.5, 7.0)
                        log(f"gaze drift: ({cur_pan},{cur_tilt}) → ({target_pan},{target_tilt}) over {duration:.1f}s")
                        ease(get_px(), cur_pan, cur_tilt, target_pan, target_tilt,
                             duration, mode="ease_gaze")
                        cur_pan, cur_tilt = target_pan, target_tilt
                        next_gaze = now + random.uniform(gaze_min, gaze_max)

            except OSError as exc:
                log(f"I2C error (will retry in {I2C_BACKOFF_S}s): {exc}")
                _health.record_failure("px-alive", f"I2C error: {exc}")
                drop_px(force_reset_on_reacquire=True)  # hard reset MCU on next get_px()
                i2c_ok_after = time.monotonic() + I2C_BACKOFF_S
                next_gaze = i2c_ok_after + random.uniform(cur_mood_behavior.get("gaze_min", GAZE_MIN_S), cur_mood_behavior.get("gaze_max", GAZE_MAX_S))
                next_scan = i2c_ok_after + random.uniform(SCAN_MIN_S, SCAN_MAX_S)
                next_prox = i2c_ok_after + PROX_CHECK_S
            else:
                _health.record_success("px-alive", min_interval_s=HEALTH_INTERVAL_S)

            time.sleep(0.5)
    finally:
        drop_px()
        if face_active:
            stop_face_detection()


def main(argv) -> int:
    global GAZE_MIN_S, GAZE_MAX_S, PROX_THRESH
    parser = argparse.ArgumentParser(description="PiCar-X idle alive daemon")
    parser.add_argument("--gaze-min",   type=float, default=GAZE_MIN_S,
                        help="Min seconds between gaze shifts")
    parser.add_argument("--gaze-max",   type=float, default=GAZE_MAX_S,
                        help="Max seconds between gaze shifts")
    parser.add_argument("--prox-cm",    type=float, default=PROX_THRESH,
                        help="Proximity threshold in cm to trigger reaction")
    parser.add_argument("--no-prox",    action="store_true",
                        help="Disable proximity sensing")
    parser.add_argument("--no-face",    action="store_true",
                        help="Disable camera face tracking")
    parser.add_argument("--dry-run",    action="store_true",
                        help="Log planned actions without moving servos")
    args = parser.parse_args(argv)

    GAZE_MIN_S  = args.gaze_min
    GAZE_MAX_S  = args.gaze_max
    PROX_THRESH = args.prox_cm if not args.no_prox else 0.0

    # Write PID — guarded: if another live px-alive already owns the file, exit
    # cleanly so we don't clobber its PID (race condition on rapid restarts).
    PID_FILE.parent.mkdir(parents=True, exist_ok=True)
    _existing_pid = None
    try:
        _existing_pid = int(PID_FILE.read_text().strip())
    except (FileNotFoundError, ValueError, OSError):
        pass  # expected on first run or corrupt PID file
    if _existing_pid and _existing_pid != os.getpid() and os.path.isdir(f"/proc/{_existing_pid}"):
        log(f"another px-alive (pid={_existing_pid}) already running — exiting")
        return 0
    PID_FILE.write_text(str(os.getpid()))

    def _safe_unlink_pid() -> None:
        """Only delete the PID file if it still contains our own PID."""
        try:
            if int(PID_FILE.read_text().strip()) == os.getpid():
                PID_FILE.unlink(missing_ok=True)
        except (FileNotFoundError, ValueError, OSError):
            pass  # expected during cleanup

    log(f"starting pid={os.getpid()} dry={args.dry_run}")

    # Signal handler for clean shutdown
    def _shutdown(sig, _frame):
        log(f"received signal {sig} — shutting down")
        _safe_unlink_pid()
        stop_face_detection()  # release camera before process exit
        sys.exit(0)  # finally block in idle_loop handles drop_px

    signal.signal(signal.SIGTERM, _shutdown)
    signal.signal(signal.SIGINT,  _shutdown)
    # Armed here, not in idle_loop: the park below runs first and must survive a
    # yield rather than be killed by Python's default SIGUSR1 disposition.
    signal.signal(signal.SIGUSR1, _on_yield)

    # Start the watchdog clock immediately: systemd begins counting from the
    # moment the unit starts, not from when the loop gets going.
    write_alive_heartbeat("starting")

    # Hardware authority is separate from exploration intent. A live, unexpired
    # tokenized lease is the only state that keeps us off GPIO owned by another
    # process. Yielding is normal and temporary, so we PARK rather than exit:
    # a clean exit under Restart=always became a 15s respawn loop that
    # re-initialised Picarx every time (47 of 111 restarts in one 6h sample).
    #
    # While parked we are strictly passive — current() only reads, and we never
    # refresh, acquire or release a token we do not own. Once the foreign lease
    # is gone/expired/dead we fall through to a fresh normal acquisition.
    def _foreign_lease():
        from pxh.gpio_lease import GpioLeaseStore
        return GpioLeaseStore(STATE_DIR).current()

    try:
        lease = _foreign_lease()
        if lease is not None:
            log("GPIO lease active (%s PID %d) — parking in lease_wait" % (
                lease["owner_kind"], lease["owner_pid"]))
            # Parked is pre-READY: `systemctl status` would otherwise show a
            # bare `activating` with no reason. The park is bounded by lease
            # expiry, and each heartbeat below extends TimeoutStartSec.
            _sd_notify("STATUS=parked: GPIO lease held by %s PID %d" % (
                lease["owner_kind"], lease["owner_pid"]))
        parked = lease is not None
        while lease is not None:
            # A yield arriving while parked is already satisfied — we hold no
            # handle. Consume it, so it cannot leak into idle_loop and make a
            # freshly-resumed daemon exit on its first iteration.
            global _yield_requested
            if _yield_requested:
                log("SIGUSR1 while parked — no GPIO held, nothing to yield")
                _yield_requested = False
            write_alive_heartbeat("lease_wait")
            time.sleep(LEASE_RECHECK_S)
            lease = _foreign_lease()
        if parked:
            log("GPIO lease cleared — resuming")
    except (ImportError, OSError, ValueError) as exc:
        log(f"GPIO lease check failed — refusing hardware startup: {exc}")
        _safe_unlink_pid()
        return 1

    if args.dry_run:
        log("dry-run: would start idle loop (servo movements skipped)")
        for i in range(3):
            target_pan  = random.randint(*PAN_RANGE)
            target_tilt = random.randint(*TILT_RANGE)
            log(f"dry gaze {i+1}: pan={target_pan} tilt={target_tilt}")
            time.sleep(0.3)
        log("dry-run: simulating idle scan sweep")
        _safe_unlink_pid()
        return 0

    # Verify picarx is importable before entering the loop
    try:
        from picarx import Picarx as _  # noqa: F401
    except Exception as exc:
        log(f"import error: {exc}")
        return 1

    try:
        idle_loop(args)
    except SystemExit:
        pass
    except Exception as exc:
        log(f"fatal: {exc}")
        return 1
    finally:
        if not args.no_face:
            stop_face_detection()
        _safe_unlink_pid()
        log("stopped")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
