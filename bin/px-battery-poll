#!/usr/bin/env bash
# px-battery-poll — write battery voltage to state/battery.json every 30s.
# Detects plug/unplug transitions and plays sweep tones + speaks.
# Run as root (needs I2C access for robot_hat ADC).
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/px-env"

/usr/bin/python3 - <<'PY'
from __future__ import annotations
import json, math, os, shutil, struct, subprocess, sys, tempfile, time, wave
from datetime import datetime, timezone
from pathlib import Path
from robot_hat.utils import get_battery_voltage

PROJECT_ROOT = Path(os.environ.get("PROJECT_ROOT", "/home/pi/picar-x-hacking"))
STATE_DIR    = Path(os.environ.get("PX_STATE_DIR", PROJECT_ROOT / "state"))
BIN_DIR      = PROJECT_ROOT / "bin"

try:
    from pxh import health as _health
except ImportError:                                   # pxh not on PYTHONPATH
    class _health:                                    # no-op shim
        record_success = staticmethod(lambda *a, **k: None)
        record_failure = staticmethod(lambda *a, **k: None)

try:
    from pxh.battery_trend import ChargeDetector
except ImportError:                                   # pxh not on PYTHONPATH
    class ChargeDetector:                             # conservative shim
        # Reporting "not charging" is the safe direction: it can cost a
        # needless shutdown while plugged in, never a suppressed one.
        charging = False

        def update(self, volts: float) -> bool:
            return False
OUT          = STATE_DIR / "battery.json"
TMP          = STATE_DIR / "battery.tmp"


def _write_battery(data: dict) -> None:
    """Write battery.json atomically with fsync for SD card durability."""
    fd, tmp = tempfile.mkstemp(dir=str(STATE_DIR), suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps(data))
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, str(OUT))
        os.chmod(str(OUT), 0o644)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise

DEVICE       = os.environ.get("PX_VOICE_DEVICE", "")
POLL_S       = 30         # check every 30s (was 60s — faster detection)

# Charge detection lives in pxh.battery_trend: per-poll deltas sit below the
# ADC's own noise floor, so the trend is measured across a 6-sample window.


VOLTAGE_FLOOR = 5.0  # 2S LiPo min is ~6.0V; anything below 5V is I2C glitch

def volts_to_pct(v: float) -> int:
    return max(0, min(100, int((v - 6.0) / (8.4 - 6.0) * 100)))


def enable_speaker() -> None:
    try:
        from robot_hat import enable_speaker as _es
        _es()
    except Exception:
        pass


def play_sweep(freq_start: float, freq_end: float, duration_s: float,
               amplitude: int = 20000) -> None:
    """Play a linear frequency sweep (rising or falling) via aplay."""
    enable_speaker()
    try:
        rate = 44100
        n = int(rate * duration_s)
        fade = int(rate * 0.02)   # 20ms fade in/out
        phase = 0.0
        samples = []
        for i in range(n):
            t = i / max(n - 1, 1)
            freq = freq_start + (freq_end - freq_start) * t
            phase += 2 * math.pi * freq / rate
            s = int(amplitude * math.sin(phase))
            if i < fade:
                s = int(s * i / fade)
            elif i > n - fade:
                s = int(s * (n - i) / fade)
            samples.append(s)

        with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tf:
            with wave.open(tf.name, "wb") as wf:
                wf.setnchannels(1)
                wf.setsampwidth(2)
                wf.setframerate(rate)
                wf.writeframes(struct.pack(f"{len(samples)}h", *samples))
            tmp = tf.name
        cmd = ["aplay", "-q"]
        if DEVICE:
            cmd += ["-D", DEVICE]
        cmd.append(tmp)
        subprocess.run(cmd, check=False, capture_output=True)
        os.unlink(tmp)
    except Exception as exc:
        print(f"[battery-poll] sweep error: {exc}", file=sys.stderr)


def speak(text: str) -> None:
    """Speak text via tool-voice (handles speaker enable + persona voice)."""
    env = os.environ.copy()
    env["PX_TEXT"] = text
    # Battery state changes are urgent onboard alerts: never route to a Nest
    # (routing would be killed by the 20s timeout before any speech), and
    # bypass night silence so plug/unplug is still heard overnight.
    env["PX_VOICE_NO_ROUTE"] = "1"
    env["PX_VOICE_URGENT"] = "1"
    try:
        subprocess.run([str(BIN_DIR / "tool-voice")], env=env,
                       capture_output=True, check=False, timeout=20)
    except Exception:
        pass


def on_plug_in(pct: int) -> None:
    """Rising sweep + 'Charging, X percent'."""
    print(f"[battery-poll] plugged in: {pct}%", file=sys.stderr)
    play_sweep(150, 1400, 1.4)
    speak(f"Charging. {pct} percent.")


def on_unplug(pct: int) -> None:
    """Falling sweep + 'Unplugged at X percent'."""
    print(f"[battery-poll] unplugged: {pct}%", file=sys.stderr)
    play_sweep(1400, 150, 1.4)
    speak(f"Unplugged at {pct} percent.")


# ── Main polling loop ────────────────────────────────────────────────
was_charging: bool = False
detector = ChargeDetector()
warmup_remaining: int = 2  # skip first N readings for ADC to settle after restart

while True:
    try:
        volts = round(get_battery_voltage(), 2)
        # ADC glitch guard: 0V (or near-zero) is physically impossible for a
        # 2S LiPo — it means the I2C read returned garbage.  Skip this tick
        # entirely so we don't write a bogus 0% that triggers emergency shutdown.
        if volts < VOLTAGE_FLOOR:
            print(f"[battery-poll] ADC glitch: {volts}V < {VOLTAGE_FLOOR}V floor — skipping", file=sys.stderr)
            # One glitch is noise; three in a row is a dead ADC. The streak in
            # health.json is what tells them apart.
            _health.record_failure("px-battery-poll",
                                   f"ADC glitch: {volts}V below {VOLTAGE_FLOOR}V floor")
            time.sleep(POLL_S)
            continue
        pct   = volts_to_pct(volts)
        ts    = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

        # Warmup: skip first readings (ADC noise on cold start causes false transitions)
        if warmup_remaining > 0:
            warmup_remaining -= 1
            # Still write state (with charging=False) so file stays fresh
            data = {"ts": ts, "volts": volts, "pct": pct, "charging": False}
            _write_battery(data)
            time.sleep(POLL_S)
            continue

        # Detect charging state from the windowed trend
        charging = detector.update(volts)
        if charging and not was_charging:
            on_plug_in(pct)
        elif was_charging and not charging:
            on_unplug(pct)

        was_charging = charging

        # Write state atomically
        data = {"ts": ts, "volts": volts, "pct": pct, "charging": charging}
        _write_battery(data)
        _health.record_success("px-battery-poll", detail={"volts": volts, "pct": pct,
                                                          "charging": charging})

    except Exception as exc:
        print(f"[battery-poll] error: {exc}", file=sys.stderr)
        _health.record_failure("px-battery-poll", str(exc))

    time.sleep(POLL_S)
PY
