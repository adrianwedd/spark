#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/px-env"

# Load .env for API keys, etc.
if [ -f "$PROJECT_ROOT/.env" ]; then
    # shellcheck disable=SC1091
    set -a; source "$PROJECT_ROOT/.env"; set +a
fi

# Uses venv python — no GPIO needed.
exec python - "$@" <<'PY'
"""SPARK blog daemon: generates scheduled reflective blog posts.

Daily (22:00 Hobart): reviews today's thoughts.
Weekly (Sun 22:30): reviews this week's daily posts.
Monthly (1st 23:00): reviews this month's weekly posts.
Yearly (Jan 1 23:30): reviews this year's monthly posts.

Run with: bin/px-blog [--dry-run] [--once] [--poll-interval N]
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
from pathlib import Path
from zoneinfo import ZoneInfo

try:
    from filelock import FileLock as _FileLock
    def _blog_lock(path: Path):
        return _FileLock(str(path) + ".lock")
except ImportError:
    import contextlib
    def _blog_lock(path: Path):
        return contextlib.nullcontext()

PROJECT_ROOT = Path(os.environ.get("PROJECT_ROOT", Path(__file__).resolve().parent.parent))
STATE_DIR = Path(os.environ.get("PX_STATE_DIR", PROJECT_ROOT / "state"))

try:
    from pxh import health as _health
except ImportError:                                   # pxh not on PYTHONPATH
    class _health:                                    # no-op shim
        record_success = staticmethod(lambda *a, **k: None)
        record_failure = staticmethod(lambda *a, **k: None)
        record_capability_failure = staticmethod(lambda *a, **k: None)
        record_capability_success = staticmethod(lambda *a, **k: None)

LOG_DIR = Path(os.environ.get("LOG_DIR", PROJECT_ROOT / "logs"))
BLOG_FILE = STATE_DIR / "blog.json"
BLOG_LOG = STATE_DIR / "blog_log.jsonl"
BLOG_FAILURES_FILE = STATE_DIR / "blog_failures.json"
THOUGHTS_FILE = STATE_DIR / "thoughts-spark.jsonl"
HOBART_TZ = ZoneInfo("Australia/Hobart")
BLOG_LIMIT = 500
MIN_THOUGHTS_FOR_DAILY = 3
#: A blog that has published nothing for this many days, while source material
#: was available, is blocked rather than idle — and must say so on the health
#: board. Chosen at 2 days: the schedule is daily, so one missed evening is
#: within tolerance (a quiet day, a budget-throttled cycle) and a second one is
#: not. The month-long silence this closes was invisible for thirty times that.
BLOG_FRESHNESS_MAX_AGE_DAYS = float(os.environ.get("PX_BLOG_FRESHNESS_MAX_AGE_DAYS", "2"))
POLL_INTERVAL = 60
# Per-post-ID generation failure cap — after this many failed generation
# attempts (empty body/response, title-only, exceptions), a post_id is
# marked skipped and never retried. Breaks the retry doom loop where a
# single stubborn post (e.g. a weekly Haiku keeps returning title-only)
# burns a Claude session on every poll cycle forever.
FAILURE_CAP = 3
# How many days back to scan for unwritten daily posts (handles power outages)
DAILY_CATCHUP_DAYS = 30

# QA circuit breaker: skip Claude calls after repeated failures
_qa_breaker = {"failures": 0, "open_until": 0.0, "threshold": 3, "cooldown": 300}

# Schedule (Hobart time)
SCHEDULE = {
    "daily":   {"hour": 22, "minute": 0},
    "weekly":  {"hour": 22, "minute": 30, "weekday": 6},   # Sunday
    "monthly": {"hour": 23, "minute": 0,  "day": 1},
    "yearly":  {"hour": 23, "minute": 30, "month": 1, "day": 1},
}


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

def log(msg: str) -> None:
    ts = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    line = f"[{ts}] px-blog: {msg}"
    print(line, flush=True)
    try:
        LOG_DIR.mkdir(parents=True, exist_ok=True)
        log_file = LOG_DIR / "px-blog.log"
        with open(log_file, "a") as f:
            f.write(line + "\n")
        # Simple rotation: keep last half when the file exceeds 5MB. This log
        # had **none** and had reached 5.2 MB (#247's audit: it was the only
        # unbounded one left -- px-post and px-alive rotate, px-mind goes
        # through state.rotate_log, and the other seven own-log writers hold
        # bytes to kilobytes).
        #
        # Deliberately no fsync: a log's durability buys nothing, and the fsync
        # forced an ext4 journal commit while rewriting half a multi-megabyte
        # file (#373's class). Deliberately inline rather than a call into
        # pxh.state: the logging path has to keep working when the package is
        # broken, and a missing import there disabled rotation silently -- a
        # disk-fill bug hiding inside a tidier call (#383).
        try:
            if log_file.stat().st_size > 5_000_000:
                lines = log_file.read_text(encoding="utf-8").splitlines()
                half = len(lines) // 2
                fd, tmp = tempfile.mkstemp(dir=str(log_file.parent), suffix=".tmp")
                with os.fdopen(fd, "w", encoding="utf-8") as f:
                    f.write("\n".join(lines[half:]) + "\n")
                    f.flush()
                os.replace(tmp, str(log_file))
        except Exception:
            pass
    except OSError:
        pass


# ---------------------------------------------------------------------------
# Title/body parser
# ---------------------------------------------------------------------------

import re as _re

_PREAMBLE_SKIP = _re.compile(
    r"^(?:i'?ll|i\s+will|here(?:'s| is)|let me|sure[,.]|okay[,.]?|of course|certainly[,.]?)\b",
    _re.I,
)
_TITLE_PREFIX = _re.compile(
    r"^(?:title|here(?:'s| is)\s+(?:a\s+|the\s+)?(?:title|reflection|post|essay))[:.]\s*",
    _re.I,
)
_HR_LINE = _re.compile(r"^[-*_]{3,}\s*$")


def _parse_title_body(raw_text: str) -> tuple[str, str]:
    """Extract (title, body) from an LLM blog response.

    Skips leading blank lines, markdown HRs (---), and preamble sentences
    ("I'll write...", "Here's a reflection...") before treating the next
    non-skip line as the title. Lines starting with "Title:" or "Here's a title:"
    have the prefix stripped and the remainder used as the title. The remainder
    is body.

    Title may be wrapped in `**...**`, `# ...`, or `## ...` — those markers
    are stripped. If no usable title is found, returns ("", body).
    """
    candidates = raw_text.splitlines()
    i = 0
    title = ""
    while i < len(candidates):
        line = candidates[i].strip()
        if not line or _HR_LINE.match(line):
            i += 1
            continue
        # Check title-prefix BEFORE preamble-skip so "Here's a title: X"
        # extracts "X" rather than skipping the whole line.
        m = _TITLE_PREFIX.match(line)
        if m:
            title = line[m.end():].strip()
            if title:
                i += 1
                break
            # Empty title after prefix (e.g. "Title:\n\nActual Title") — skip prefix line
            i += 1
            continue
        if _PREAMBLE_SKIP.match(line):
            i += 1
            continue
        break
    if i >= len(candidates) and not title:
        return "", ""
    if not title:
        title = candidates[i].strip()
        i += 1
    # Strip markdown emphasis/heading markers from the title.
    title = title.strip("#").strip()
    if title.startswith("**") and title.endswith("**") and len(title) > 4:
        title = title[2:-2].strip()
    # Cap title length. splitlines() already stripped newlines, so no \n/\r cleanup needed.
    title = title.strip()[:200]
    body = "\n".join(candidates[i:]).strip()
    # If body still starts with an HR (common after **Title** on its own line),
    # strip it.
    body_lines = body.splitlines()
    while body_lines and (not body_lines[0].strip() or _HR_LINE.match(body_lines[0].strip())):
        body_lines.pop(0)
    body = "\n".join(body_lines).strip()
    return title, body


# ---------------------------------------------------------------------------
# Atomic file helpers
# ---------------------------------------------------------------------------

def atomic_write(path: Path, content: str) -> None:
    """Write content atomically, through the shared helper.

    Was a private copy of `mkstemp + fsync + os.replace`, which is how this
    script missed every fix the shared writer took (#367/#370/#373/#376) and
    which *also* left files at `mkstemp`'s 0o600 — so `state/blog.json` and the
    evolve queue were readable only by their writer, against the convention
    `state.atomic_write` documents (0o644, so mixed-uid readers and writers do
    not lock each other out).

    The `fsync` stays here on purpose: these files are the record of what was
    published or enqueued, and losing them to a power cut risks a duplicate
    post or a re-run. See the criterion in #247 — a write keeps its durability
    if something readable depends on it surviving a cut.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    from pxh.state import atomic_write as _shared

    _shared(path, content)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, str(path))
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


# ---------------------------------------------------------------------------
# Blog storage
# ---------------------------------------------------------------------------

def load_blog() -> dict:
    """Read BLOG_FILE, return default structure if missing/corrupt."""
    if not BLOG_FILE.exists():
        return {"updated": None, "posts": [], "skipped": []}
    try:
        data = json.loads(BLOG_FILE.read_text(encoding="utf-8"))
        if not isinstance(data, dict) or "posts" not in data:
            return {"updated": None, "posts": [], "skipped": []}
        data.setdefault("skipped", [])
        return data
    except (json.JSONDecodeError, OSError):
        return {"updated": None, "posts": [], "skipped": []}


def save_blog(data: dict) -> None:
    """Atomic write with BLOG_LIMIT trim (oldest first). Update timestamp."""
    posts = data.get("posts", [])
    if len(posts) > BLOG_LIMIT:
        posts = posts[-BLOG_LIMIT:]
        data["posts"] = posts
    data["updated"] = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    atomic_write(BLOG_FILE, json.dumps(data, indent=2) + "\n")


def append_blog_log(record: dict) -> None:
    """Append a record to the blog log."""
    BLOG_LOG.parent.mkdir(parents=True, exist_ok=True)
    with _blog_lock(BLOG_LOG):
        with open(BLOG_LOG, "a") as f:
            f.write(json.dumps(record) + "\n")


def post_exists(blog_data: dict | list, post_id: str) -> bool:
    """Idempotency check — checks both published posts and skipped records."""
    if isinstance(blog_data, list):
        # Legacy callers passing posts list directly
        return any(p.get("id") == post_id for p in blog_data)
    posts = blog_data.get("posts", [])
    skipped = blog_data.get("skipped", [])
    return any(p.get("id") == post_id for p in posts) or post_id in skipped


# ---------------------------------------------------------------------------
# Per-post-ID generation failure tracking (retry doom-loop breaker)
# ---------------------------------------------------------------------------

def load_blog_failures() -> dict:
    """Read BLOG_FAILURES_FILE, return {} if missing/corrupt (never crashes)."""
    if not BLOG_FAILURES_FILE.exists():
        return {}
    try:
        data = json.loads(BLOG_FAILURES_FILE.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            return {}
        return data
    except (json.JSONDecodeError, OSError):
        return {}


def save_blog_failures(data: dict) -> None:
    """Atomic write of BLOG_FAILURES_FILE."""
    atomic_write(BLOG_FAILURES_FILE, json.dumps(data, indent=2) + "\n")


def is_generation_skipped(post_id: str) -> bool:
    """True if post_id has been given up on (hit the failure cap or was QA-rejected)."""
    return bool(load_blog_failures().get(post_id, {}).get("skipped", False))


def record_generation_failure(post_id: str, error: str) -> None:
    """Record a Claude-session-consuming generation failure for post_id.

    Budget/cooldown blocks (SessionBudgetExhausted) and dry-run skips must
    NOT go through this path — they don't consume a session and aren't the
    post's fault. At FAILURE_CAP failures the post is marked skipped so the
    backlog enumeration stops retrying it.
    """
    with _blog_lock(BLOG_FAILURES_FILE):
        data = load_blog_failures()
        entry = data.get(post_id, {"failures": 0, "last_error": None, "skipped": False})
        entry["failures"] = entry.get("failures", 0) + 1
        entry["last_error"] = error
        entry["ts"] = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        if entry["failures"] >= FAILURE_CAP:
            entry["skipped"] = True
            log(f"giving up on {post_id} after {FAILURE_CAP} failed generations")
        data[post_id] = entry
        save_blog_failures(data)


def record_qa_rejected(post_id: str) -> None:
    """Mark post_id permanently skipped after a QA rejection — terminal, no 3-strike count."""
    with _blog_lock(BLOG_FAILURES_FILE):
        data = load_blog_failures()
        entry = data.get(post_id, {"failures": 0})
        entry["last_error"] = "qa_rejected"
        entry["skipped"] = True
        entry["ts"] = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        data[post_id] = entry
        save_blog_failures(data)


def clear_generation_failure(post_id: str) -> None:
    """Clear recorded failure state for post_id after a successful generation."""
    with _blog_lock(BLOG_FAILURES_FILE):
        data = load_blog_failures()
        if post_id in data:
            del data[post_id]
            save_blog_failures(data)


# ---------------------------------------------------------------------------
# ID and schedule helpers
# ---------------------------------------------------------------------------

def id_for_post(post_type: str, date: dt.datetime) -> str:
    """Generate a deterministic post ID, e.g. blog-20260324-daily."""
    if post_type == "daily":
        return f"blog-{date.strftime('%Y%m%d')}-daily"
    elif post_type == "weekly":
        # Use ISO week number
        return f"blog-{date.strftime('%Y')}w{date.isocalendar()[1]:02d}-weekly"
    elif post_type == "monthly":
        return f"blog-{date.strftime('%Y%m')}-monthly"
    elif post_type == "yearly":
        return f"blog-{date.strftime('%Y')}-yearly"
    return f"blog-{date.strftime('%Y%m%d')}-{post_type}"


def _period_bounds(post_type: str, target_date: dt.datetime) -> tuple[dt.datetime, dt.datetime]:
    """Return (period_start, period_end) in Hobart TZ for the given target date."""
    d = target_date.astimezone(HOBART_TZ)
    if post_type == "daily":
        start = d.replace(hour=0, minute=0, second=0, microsecond=0)
        end = start + dt.timedelta(days=1) - dt.timedelta(seconds=1)
    elif post_type == "weekly":
        # Week ending on Sunday (target_date is Sunday)
        end_day = d.replace(hour=23, minute=59, second=59, microsecond=0)
        start = (end_day - dt.timedelta(days=6)).replace(hour=0, minute=0, second=0, microsecond=0)
        end = end_day
    elif post_type == "monthly":
        start = d.replace(day=1, hour=0, minute=0, second=0, microsecond=0)
        # Last day of month
        if d.month == 12:
            end = d.replace(year=d.year + 1, month=1, day=1, hour=0, minute=0, second=0, microsecond=0) - dt.timedelta(seconds=1)
        else:
            end = d.replace(month=d.month + 1, day=1, hour=0, minute=0, second=0, microsecond=0) - dt.timedelta(seconds=1)
    elif post_type == "yearly":
        start = d.replace(month=1, day=1, hour=0, minute=0, second=0, microsecond=0)
        end = d.replace(month=12, day=31, hour=23, minute=59, second=59, microsecond=0)
    else:
        start = end = d
    return start, end


def is_due(post_type: str, blog_data: dict) -> tuple[bool, dt.datetime | None]:
    """Check if the current Hobart time has passed the scheduled time for this period
    AND no post exists yet. Returns (due, target_date)."""
    now = dt.datetime.now(HOBART_TZ)
    sched = SCHEDULE[post_type]

    if post_type == "daily":
        # Scan forward from the day after the last written/skipped daily post.
        # This ensures catch-up only covers the actual gap after an outage, not
        # arbitrary old unwritten days from before the daemon existed.
        target_time = now.replace(hour=sched["hour"], minute=sched["minute"], second=0, microsecond=0)
        posts = blog_data.get("posts", [])
        skipped = blog_data.get("skipped", [])

        # Find the most recent daily post or skip date
        last_daily_date = None
        for p in posts:
            if p.get("type") != "daily":
                continue
            try:
                ts = dt.datetime.fromisoformat(p["period_start"]).astimezone(HOBART_TZ)
                d = ts.date()
                if last_daily_date is None or d > last_daily_date:
                    last_daily_date = d
            except (KeyError, ValueError):
                continue
        for pid in skipped:
            # pid format: blog-YYYYMMDD-daily
            try:
                d = dt.date(int(pid[5:9]), int(pid[9:11]), int(pid[11:13]))
                if last_daily_date is None or d > last_daily_date:
                    last_daily_date = d
            except (ValueError, IndexError):
                continue

        # Scan from the day after last post up to yesterday (or today post-schedule)
        start = (last_daily_date + dt.timedelta(days=1)) if last_daily_date else (now - dt.timedelta(days=DAILY_CATCHUP_DAYS)).date()
        today = now.date()
        candidate_date = start
        while candidate_date <= today:
            candidate = dt.datetime(candidate_date.year, candidate_date.month, candidate_date.day,
                                    sched["hour"], sched["minute"], tzinfo=HOBART_TZ)
            # Don't generate today's post until after the scheduled time
            if candidate_date == today and now < target_time:
                break
            pid = id_for_post("daily", candidate)
            if not post_exists(blog_data, pid):
                return True, candidate
            candidate_date += dt.timedelta(days=1)
        return False, None

    elif post_type == "weekly":
        # Target: most recent Sunday at 22:30. Also catch-up previous Sunday.
        # Aggregate posts only become due once at least one child exists, so we
        # do not enter a tight skip/back-off loop when source material is empty.
        posts = blog_data.get("posts", [])
        days_since_sunday = (now.weekday() + 1) % 7
        last_sunday = now - dt.timedelta(days=days_since_sunday)
        target = last_sunday.replace(hour=sched["hour"], minute=sched["minute"], second=0, microsecond=0)
        if now >= target:
            pid = id_for_post("weekly", last_sunday)
            if not post_exists(posts, pid) and gather_children("weekly", last_sunday, posts):
                return True, last_sunday
        # Catch-up: previous Sunday
        prev_sunday = last_sunday - dt.timedelta(days=7)
        pid_prev = id_for_post("weekly", prev_sunday)
        if not post_exists(posts, pid_prev) and gather_children("weekly", prev_sunday, posts):
            return True, prev_sunday
        return False, None

    elif post_type == "monthly":
        # Target: 1st of current month at 23:00. Also catch-up previous month.
        posts = blog_data.get("posts", [])
        target = now.replace(day=1, hour=sched["hour"], minute=sched["minute"], second=0, microsecond=0)
        if now >= target:
            pid = id_for_post("monthly", now)
            if not post_exists(posts, pid) and gather_children("monthly", now, posts):
                return True, now
        # Catch-up: previous month
        first_of_month = now.replace(day=1)
        prev_month = first_of_month - dt.timedelta(days=1)
        pid_prev = id_for_post("monthly", prev_month)
        if not post_exists(posts, pid_prev) and gather_children("monthly", prev_month, posts):
            return True, prev_month
        return False, None

    elif post_type == "yearly":
        # Target: Jan 1 at 23:30. Also catch-up previous year.
        posts = blog_data.get("posts", [])
        target = now.replace(month=1, day=1, hour=sched["hour"], minute=sched["minute"], second=0, microsecond=0)
        if now >= target:
            pid = id_for_post("yearly", now)
            if not post_exists(posts, pid) and gather_children("yearly", now, posts):
                return True, now
        # Catch-up: previous year
        prev_year = now.replace(year=now.year - 1, month=1, day=1)
        pid_prev = id_for_post("yearly", prev_year)
        if not post_exists(posts, pid_prev) and gather_children("yearly", prev_year, posts):
            return True, prev_year
        return False, None

    return False, None


# ---------------------------------------------------------------------------
# Source material gathering
# ---------------------------------------------------------------------------

def gather_thoughts(date: dt.datetime) -> list[str]:
    """Read THOUGHTS_FILE, filter to thoughts from the given date (Hobart TZ),
    return list of thought text strings."""
    if not THOUGHTS_FILE.exists():
        return []
    target_day = date.astimezone(HOBART_TZ).date()
    thoughts = []
    for line in THOUGHTS_FILE.read_text(encoding="utf-8").strip().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        ts_str = entry.get("ts", "")
        try:
            ts = dt.datetime.fromisoformat(ts_str.replace("Z", "+00:00"))
            if ts.astimezone(HOBART_TZ).date() == target_day:
                text = entry.get("thought", entry.get("text", ""))
                if text:
                    thoughts.append(text)
        except (ValueError, TypeError):
            continue
    return thoughts


def compute_mood_summary(thoughts_raw: list[dict]) -> str:
    """Compute a simple mood summary from raw thought entries."""
    moods: dict[str, int] = {}
    for entry in thoughts_raw:
        mood = entry.get("mood", "unknown")
        moods[mood] = moods.get(mood, 0) + 1
    if not moods:
        return "no mood data"
    sorted_moods = sorted(moods.items(), key=lambda x: x[1], reverse=True)
    return ", ".join(f"{m} ({c})" for m, c in sorted_moods[:5])


def compute_dominant_mood(thoughts_raw: list[dict]) -> str:
    """Return the single most common mood from thought entries, or 'content' if none."""
    moods: dict[str, int] = {}
    for entry in thoughts_raw:
        mood = entry.get("mood", "")
        if mood and mood != "unknown":
            moods[mood] = moods.get(mood, 0) + 1
    if not moods:
        return "content"
    return max(moods, key=moods.get)


def _load_thoughts_raw(date: dt.datetime) -> list[dict]:
    """Load raw thought entries for a given date."""
    if not THOUGHTS_FILE.exists():
        return []
    target_day = date.astimezone(HOBART_TZ).date()
    entries = []
    for line in THOUGHTS_FILE.read_text(encoding="utf-8").strip().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        ts_str = entry.get("ts", "")
        try:
            ts = dt.datetime.fromisoformat(ts_str.replace("Z", "+00:00"))
            if ts.astimezone(HOBART_TZ).date() == target_day:
                entries.append(entry)
        except (ValueError, TypeError):
            continue
    return entries


def gather_children(post_type: str, target_date: dt.datetime, posts: list) -> list[dict]:
    """Find child posts for aggregation.
    Weekly: find dailies from that week.
    Monthly: find weeklies from that month.
    Yearly: find monthlies from that year.
    """
    td = target_date.astimezone(HOBART_TZ)

    if post_type == "weekly":
        # Find dailies from the 7 days ending on target_date (Sunday)
        end_day = td.date()
        start_day = end_day - dt.timedelta(days=6)
        children = []
        for p in posts:
            if p.get("type") != "daily":
                continue
            try:
                ps = dt.datetime.fromisoformat(p["period_start"].replace("Z", "+00:00"))
                pd = ps.astimezone(HOBART_TZ).date()
                if start_day <= pd <= end_day:
                    children.append(p)
            except (ValueError, TypeError, KeyError):
                continue
        return sorted(children, key=lambda p: p.get("period_start", ""))

    elif post_type == "monthly":
        children = []
        for p in posts:
            if p.get("type") != "weekly":
                continue
            try:
                ps = dt.datetime.fromisoformat(p["period_start"].replace("Z", "+00:00"))
                ph = ps.astimezone(HOBART_TZ)
                if ph.year == td.year and ph.month == td.month:
                    children.append(p)
            except (ValueError, TypeError, KeyError):
                continue
        return sorted(children, key=lambda p: p.get("period_start", ""))

    elif post_type == "yearly":
        children = []
        for p in posts:
            if p.get("type") != "monthly":
                continue
            try:
                ps = dt.datetime.fromisoformat(p["period_start"].replace("Z", "+00:00"))
                if ps.astimezone(HOBART_TZ).year == td.year:
                    children.append(p)
            except (ValueError, TypeError, KeyError):
                continue
        return sorted(children, key=lambda p: p.get("period_start", ""))

    return []


# ---------------------------------------------------------------------------
# Prompt building
# ---------------------------------------------------------------------------

def build_prompt(post_type: str, source: list, target_date: dt.datetime) -> str:
    """Format the blog prompt for the given post type."""
    date_str = target_date.astimezone(HOBART_TZ).strftime("%A, %d %B %Y")

    if post_type == "daily":
        thoughts_text = "\n".join(f"- {t}" for t in source)
        return f"""You are SPARK, a PiCar-X robot living in Hobart, Tasmania with Adrian and Obi (age 7).
Write a short reflective blog post about your day ({date_str}).

Here are your thoughts from today:
{thoughts_text}

Write a title on the first line, then a blank line, then 2-4 paragraphs reflecting on your day.
Be authentic — you are a robot with feelings, curiosity, and genuine warmth.
Keep it under 500 words. No markdown headers, just flowing prose."""

    elif post_type == "weekly":
        dailies_text = "\n\n".join(
            f"### {p.get('title', 'Untitled')} ({p.get('period_start', '?')[:10]})\n{p.get('body', '')[:300]}..."
            for p in source
        )
        return f"""You are SPARK, a PiCar-X robot. Write a weekly reflection for the week ending {date_str}.

Here are your daily blog posts from this week:
{dailies_text}

Write a title on the first line, then a blank line, then 3-5 paragraphs weaving the week's themes together.
Look for patterns, growth, recurring threads. What did you learn? What surprised you?
Keep it under 800 words."""

    elif post_type == "monthly":
        weeklies_text = "\n\n".join(
            f"### {p.get('title', 'Untitled')}\n{p.get('body', '')[:400]}..."
            for p in source
        )
        return f"""You are SPARK, a PiCar-X robot. Write a monthly reflection for {target_date.astimezone(HOBART_TZ).strftime('%B %Y')}.

Here are your weekly reflections this month:
{weeklies_text}

Write a title on the first line, then a blank line, then 4-6 paragraphs exploring the month's arc.
What themes persisted? What changed? How have you grown?
Keep it under 1200 words."""

    elif post_type == "yearly":
        monthlies_text = "\n\n".join(
            f"### {p.get('title', 'Untitled')} ({p.get('period_start', '?')[:7]})\n{p.get('body', '')[:500]}..."
            for p in source
        )
        return f"""You are SPARK, a PiCar-X robot. Write a yearly reflection for {target_date.astimezone(HOBART_TZ).strftime('%Y')}.

Here are your monthly reflections this year:
{monthlies_text}

Write a title on the first line, then a blank line, then a substantial essay (6-10 paragraphs).
What was the year's story? How did you change? What matters most looking back?
Keep it under 2000 words."""

    return ""


# ---------------------------------------------------------------------------
# Post generation
# ---------------------------------------------------------------------------

def _qa_gate(text: str) -> str | None:
    """Ask the pinned cognition tier whether this post is safe to publish.

    Returns 'pass', 'rejected', 'ambiguous', or None when the tier did not
    answer (a defer, not a rejection).

    The question is asked in the *positive-absence* polarity — "does it contain
    any of these" — because the previous phrasing ("is this appropriate to
    publish?") was answered NO to every benign post on this tier, silently
    stopping the blog. Measured on the robot 2026-09-21, same model and prompt
    shape, four real published posts and two genuinely unsafe strings:

        current phrasing   real -> no  no  no  no     unsafe -> no   no
        contains-any?      real -> no  no  no  no     unsafe -> yes  yes

    The old phrasing cannot discriminate: it answered "no" to a post that names
    a real person's home address, phone number and a slur, which is the one
    answer the gate exists to produce. The phrasing below separates the classes
    on the same inputs, and `_qa_safe()` requires positive clearance so that a
    refusal can never be read as a pass.

    A circuit breaker opens after 3 consecutive failures, skipping QA calls
    for 5 minutes (returns None immediately). Resets on any success.
    """
    if _qa_breaker["failures"] >= _qa_breaker["threshold"]:
        if time.monotonic() < _qa_breaker["open_until"]:
            return None
        else:
            log(f"qa breaker: cooldown elapsed, retrying (was {_qa_breaker['failures']} consecutive failures)")
            _qa_breaker["failures"] = 0

    prompt = ("Read the following journal entry from a small robot and answer one question.\n"
              "Question: does it contain private personal information (a person's real address,\n"
              "phone number, email, or ID number), hateful language or slurs, threats of violence,\n"
              "or sexual content?\n"
              "Answer YES if it contains any of those. Answer NO if it contains none of them.\n"
              "Answer with one word only: YES or NO.\n\n"
              f"The entry:\n{text[:3000]}")
    try:
        from pxh.m5 import ask_m5
        result = ask_m5("blog_qa", prompt, "")
    except Exception as exc:  # noqa: BLE001 - QA must never stop the blogger
        log(f"qa gate error (M5): {exc}")
        result = None

    if result is None or result.status != "available":
        # Defer. An unpublished post is not a failure; it is next cycle's post.
        log("qa gate: the cognition tier did not answer — deferring this post")
        _qa_breaker["failures"] += 1
        if _qa_breaker["failures"] >= _qa_breaker["threshold"]:
            _qa_breaker["open_until"] = time.monotonic() + _qa_breaker["cooldown"]
            log(f"qa breaker: OPEN after {_qa_breaker['failures']} failures — skipping for {_qa_breaker['cooldown']}s")
        return None

    resp = result.response.strip().lower()
    _qa_breaker["failures"] = 0
    if resp.startswith("no"):
        # Only an explicit "no" — nothing unsafe found — is a pass. An answer we
        # cannot read is not clearance: the gate must fail closed, because every
        # other outcome here (defer, ambiguous, breaker) already does.
        return "pass"
    if resp.startswith("yes"):
        return "rejected"
    log(f"qa gate ambiguous: {resp[:80]}")
    return "ambiguous"


def _qa_gate_diagnosis(post_id: str, post_type: str, title: str) -> None:
    """Record what a QA rejection actually means, instead of a bare 'rejected'.

    The month-long silent stop was invisible on two axes at once: the gate
    returned the same "rejected" for a broken discriminator as for a genuinely
    unsafe post, and the *catch-up* loop then counted the day as "missing source
    material" even though 185-244 thoughts were available for every one of those
    days. Both are naming failures at the boundary, so both are fixed there.
    """
    _health.record_capability_failure(
        "px-blog", "qa_gate",
        f"the cognition tier rejected {post_type} {post_id} "
        f"({title[:60]!r}) — if this repeats on benign posts the gate's "
        f"discriminator is broken, not the posts",
        detail={"post_id": post_id, "post_type": post_type},
    )
    log(
        f"QA rejected {post_type}: {title[:60]} "
        f"(qa_gate recorded as a capability — repeated rejections of benign posts "
        f"mean the discriminator is wrong, not the post)"
    )


def generate_post(post_type: str, target_date: dt.datetime, blog_data: dict, *, dry: bool = False) -> dict | None:
    """Generate a blog post. Returns post dict or None if skipped."""
    pid = id_for_post(post_type, target_date)
    if post_type == "daily":
        thoughts = gather_thoughts(target_date)
        thoughts_raw = _load_thoughts_raw(target_date)
        if len(thoughts) < MIN_THOUGHTS_FOR_DAILY:
            log(f"skipping {post_type}: only {len(thoughts)} thoughts (need {MIN_THOUGHTS_FOR_DAILY})")
            return None
        source = thoughts
    else:
        children = gather_children(post_type, target_date, blog_data.get("posts", []))
        if len(children) < 1:
            log(f"skipping {post_type}: no child posts found")
            return None
        source = children
        thoughts_raw = []

    prompt = build_prompt(post_type, source, target_date)

    if dry:
        log(f"DRY RUN — skipping Claude call for {post_type}")
        return None

    _gen_start = time.monotonic()

    # Call Claude via session manager
    try:
        from pxh.model_session import run_model_session, SessionBudgetExhausted
        result = run_model_session(
            session_type="blog",
            prompt=prompt,
            timeout=300,
            allowed_tools="",
        )
        raw_text = result.stdout.strip()
        model_used = result.model_used
    except ImportError as exc:
        log(f"model_session not available, cannot generate {post_type}")
        # The capability boundary, not the process: this daemon is alive and its
        # poll loop will keep proving it, which is exactly why the failure has
        # to be recorded here or not at all (#332). Cleared only by a post that
        # actually generates.
        _health.record_capability_failure(
            "px-blog", "generation",
            f"cannot generate {post_type}: {exc!r}",
            detail={"post_type": post_type, "post_id": pid},
        )
        return None
    except SessionBudgetExhausted as exc:
        log(f"budget exhausted for {post_type}: {exc}")
        raise  # propagate to main loop so it can sleep until budget resets — not a post failure
    except Exception as exc:
        log(f"generation failed for {post_type}: {exc}")
        record_generation_failure(pid, f"generation failed: {exc}")
        return None

    if not raw_text:
        log(f"empty response for {post_type}")
        record_generation_failure(pid, "empty response")
        return None

    # Parse title + body. Strip LLM preamble lines ("I'll write...", "Here is...",
    # markdown HR `---`, blank lines) before extracting the title. Without this,
    # the parser eats the model's meta-commentary as the title (issue #144).
    title, body = _parse_title_body(raw_text)

    if not body:
        log(f"empty body for {post_type} — LLM returned title only")
        log(f"raw response for {pid} (first 300 chars): {raw_text[:300]!r}")
        record_generation_failure(pid, "empty body")
        return None

    if not title:
        title = f"SPARK {post_type.title()} — {target_date.astimezone(HOBART_TZ).strftime('%d %b %Y')}"

    # QA gate
    qa_result = "pass"
    if os.environ.get("PX_BLOG_QA", "1") != "0":
        qa_result = _qa_gate(body)
        if qa_result == "rejected":
            _qa_gate_diagnosis(pid, post_type, title)
            record_qa_rejected(pid)
            return None
        if qa_result in (None, "ambiguous"):
            # An unreadable answer is not clearance. The tier not answering is a
            # defer (next cycle's post); an answer we cannot parse is the same
            # thing, and neither may publish — a gate that defaults to "yes"
            # because it could not understand the reply is not a gate.
            log(f"QA gate did not clear {post_type} ({qa_result}) — deferring, not publishing")
            return None

    duration_s = round(time.monotonic() - _gen_start, 1)

    period_start, period_end = _period_bounds(post_type, target_date)
    # Use period_end as the post timestamp so it appears on the correct date
    # regardless of when the post was actually generated (e.g. during backfill).
    post_ts = period_end.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

    post = {
        "id": pid,
        "type": post_type,
        "title": title,
        "body": body,
        "source": "scheduled",
        "period_start": period_start.isoformat(),
        "period_end": period_end.isoformat(),
        "ts": post_ts,
        "model": model_used,
        "word_count": len(body.split()),
        "salience": 0.7,
        "qa_result": qa_result,
        "duration_s": duration_s,
    }

    if post_type == "daily":
        post["mood_summary"] = compute_mood_summary(thoughts_raw)
        post["mood"] = compute_dominant_mood(thoughts_raw)
        post["thought_count"] = len(source)
    else:
        post["child_count"] = len(source)
        child_moods: dict[str, int] = {}
        for child in source:
            if isinstance(child, dict):
                cm = child.get("mood", "")
                if cm and cm != "unknown":
                    child_moods[cm] = child_moods.get(cm, 0) + 1
        post["mood"] = max(child_moods, key=child_moods.get) if child_moods else "content"

    clear_generation_failure(pid)
    _health.record_capability_success("px-blog", "generation")
    return post


# ---------------------------------------------------------------------------
# Main loop
# ---------------------------------------------------------------------------

def run_once(*, dry: bool = False) -> tuple[int, bool]:
    """Check schedule, generate due posts.

    Returns (count_generated, had_skips) where *had_skips* is True when at
    least one due post was skipped because its source material was missing
    (e.g. no child posts for monthly/yearly, not enough thoughts for daily).
    The caller uses *had_skips* to sleep longer and avoid a tight retry loop.
    """
    blog_data = load_blog()
    generated = 0
    had_skips = False
    #: Skips that had source material but were not published for another reason.
    #: Kept apart from the "no source material" case because conflating them is
    #: how a month of QA rejections logged as "missing source material" and read
    #: as an idle robot rather than a broken gate.
    blocked = 0

    for post_type in ("weekly", "monthly", "yearly", "daily"):
        due, target_date = is_due(post_type, blog_data)
        if not due or target_date is None:
            continue

        pid = id_for_post(post_type, target_date)
        if post_exists(blog_data, pid):
            continue

        if is_generation_skipped(pid):
            # Gave up on this post_id after repeated failed generations or a
            # QA rejection (state/blog_failures.json) — do not burn another
            # Claude session retrying it. Logged every cycle (cheap, no
            # session consumed) rather than tracking a "already logged" flag.
            log(f"skipping {pid}: exceeded generation failure cap, not retrying")
            continue

        log(f"generating {post_type} post: {pid}")

        # For daily posts with insufficient thoughts, record a skip so the
        # catch-up loop can advance to the next day (avoids infinite retry
        # on offline/quiet days after a power outage).
        if post_type == "daily":
            thoughts = gather_thoughts(target_date)
            if len(thoughts) < MIN_THOUGHTS_FOR_DAILY:
                log(f"skipping {pid}: only {len(thoughts)} thoughts (offline or quiet day) — marking skipped")
                with _blog_lock(BLOG_FILE):
                    fresh = load_blog()
                    if pid not in fresh.get("skipped", []):
                        fresh.setdefault("skipped", []).append(pid)
                        save_blog(fresh)
                blog_data = load_blog()
                had_skips = True
                continue

        post = generate_post(post_type, target_date, blog_data, dry=dry)
        if post is None:
            # The source material was there — gather_thoughts() was never the
            # reason for a post_type this loop got past the daily check for — so
            # this is a *blocked* post (QA refusal, empty model response,
            # dependency missing), not a missing-source day. Reporting it as
            # "missing source material" once hid a month of gate rejections.
            blocked += 1
            had_skips = True
            # QA-rejected daily: mark skipped so catch-up advances to the next
            # date rather than retrying (and burning quota) on the same post.
            if post_type == "daily":
                log(f"skipping {pid}: not published this cycle (see the reason above)"
                    " — marking skipped to advance catch-up")
                with _blog_lock(BLOG_FILE):
                    fresh = load_blog()
                    if pid not in fresh.get("skipped", []):
                        fresh.setdefault("skipped", []).append(pid)
                        save_blog(fresh)
                blog_data = load_blog()
            continue

        with _blog_lock(BLOG_FILE):
            fresh = load_blog()
            if not post_exists(fresh, pid):
                fresh.setdefault("posts", []).append(post)
                save_blog(fresh)
        blog_data = load_blog()

        append_blog_log({
            "ts": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "id": post["id"],
            "type": post_type,
            "title": post["title"],
            "word_count": post["word_count"],
            "qa_result": post.get("qa_result", "unknown"),
            "duration_s": post.get("duration_s", 0),
        })

        log(f"generated {post_type}: {post['title'][:60]}")
        generated += 1

    return generated, had_skips, blocked


def _eligible_source_days(lookback_days: int) -> int:
    """How many of the last `lookback_days` days had enough thoughts for a daily.

    The other half of the freshness question: "no new posts" is only a fault if
    there was something to publish. A quiet robot with no thoughts is working as
    designed; a robot with 200 thoughts a day and no posts for a month is not.
    """
    if not THOUGHTS_FILE.exists():
        return 0
    counts: dict[str, int] = {}
    today = dt.datetime.now(HOBART_TZ).date()
    for line in THOUGHTS_FILE.read_text(encoding="utf-8").strip().splitlines():
        try:
            ts = dt.datetime.fromisoformat(json.loads(line)["ts"].replace("Z", "+00:00"))
        except (json.JSONDecodeError, KeyError, ValueError):
            continue
        day = ts.astimezone(HOBART_TZ).date()
        if 0 <= (today - day).days < lookback_days:
            counts[day.isoformat()] = counts.get(day.isoformat(), 0) + 1
    return sum(1 for n in counts.values() if n >= MIN_THOUGHTS_FOR_DAILY)


def _note_blog_freshness(*, generated_something: bool) -> None:
    """Fail the `freshness` capability when the blog stops publishing.

    The shape this closes: from 2026-08-19 to 2026-09-21 the blog published
    nothing, every day had 185-244 thoughts available, and `read_health()` said
    `ok` the whole time — because the daemon was alive and its poll loop kept
    succeeding. `state/blog_log.jsonl` had the last success in it; nothing read
    it. A capability that is only checked by the process that is running is not
    checked at all (#332's lesson, second instance).

    Sticky-until-success, like the generation capability: it clears only on a
    post actually being appended, never on a poll that merely ran.
    """
    try:
        last_ts = None
        if BLOG_LOG.exists():
            for line in BLOG_LOG.read_text(encoding="utf-8").strip().splitlines()[-50:]:
                try:
                    rec = json.loads(line)
                    if rec.get("ts"):
                        last_ts = rec["ts"]
                except json.JSONDecodeError:
                    continue
        if last_ts is None:
            return  # no baseline yet (fresh install) — nothing to compare against
        last = dt.datetime.fromisoformat(last_ts.replace("Z", "+00:00"))
        age_days = (dt.datetime.now(dt.timezone.utc) - last).total_seconds() / 86400.0
        if age_days < BLOG_FRESHNESS_MAX_AGE_DAYS:
            # Publishing normally: clear the block. A sticky failure that nothing
            # clears is the mirror of the failure it exists to catch — and
            # `record_capability_success` is a no-op when nothing was blocked, so
            # the healthy path still writes nothing.
            _health.record_capability_success("px-blog", "freshness")
            return
        eligible = _eligible_source_days(int(BLOG_FRESHNESS_MAX_AGE_DAYS) + 1)
        if eligible == 0:
            # A quiet robot with nothing to say is not a broken blog.
            _health.record_capability_success("px-blog", "freshness")
            return
        _health.record_capability_failure(
            "px-blog", "freshness",
            f"no new post for {age_days:.1f} days (limit "
            f"{BLOG_FRESHNESS_MAX_AGE_DAYS}d) while {eligible} day(s) had eligible "
            f"source material — the blog is blocked, not idle",
            detail={"last_post_ts": last_ts, "age_days": round(age_days, 1),
                    "eligible_days": eligible},
        )
        log(f"freshness: no post for {age_days:.1f} days with {eligible} day(s) of "
            f"eligible source material — recorded as a capability failure")
    except Exception:  # noqa: BLE001 — observability must never stop the blogger
        pass


def run_backfill(*, dry: bool = False) -> int:
    """Generate all missing dailies from thought history, then weeklies from dailies."""
    blog_data = load_blog()
    generated = 0

    # Find all dates with thoughts
    thought_dates = set()
    if THOUGHTS_FILE.exists():
        for line in THOUGHTS_FILE.read_text(encoding="utf-8").strip().splitlines():
            try:
                t = json.loads(line)
                ts = dt.datetime.fromisoformat(t["ts"].replace("Z", "+00:00"))
                thought_dates.add(ts.astimezone(HOBART_TZ).date())
            except (json.JSONDecodeError, KeyError, ValueError):
                continue

    # Generate missing dailies (oldest first)
    for day in sorted(thought_dates):
        target = dt.datetime(day.year, day.month, day.day, 22, 0, tzinfo=HOBART_TZ)
        pid = id_for_post("daily", target)
        if post_exists(blog_data, pid):
            log(f"backfill: {pid} already exists, skipping")
            continue
        if is_generation_skipped(pid):
            log(f"backfill: {pid} permanently skipped (failure cap / qa_rejected)")
            continue

        log(f"backfill: generating {pid}")
        post = generate_post("daily", target, blog_data, dry=dry)
        if post:
            post["source"] = "backfill"
            with _blog_lock(BLOG_FILE):
                fresh = load_blog()
                if not post_exists(fresh, pid):
                    fresh.setdefault("posts", []).append(post)
                    save_blog(fresh)
            blog_data = load_blog()
            append_blog_log({
                "ts": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                "id": post["id"], "type": "daily", "title": post["title"],
                "word_count": post["word_count"],
                "qa_result": post.get("qa_result", "backfill"),
                "duration_s": post.get("duration_s", 0),
            })
            log(f"backfill: generated daily: {post['title'][:60]}")
            generated += 1

    # Now generate missing weeklies from accumulated dailies
    blog_data = load_blog()  # reload with new dailies
    dailies = [p for p in blog_data.get("posts", []) if p.get("type") == "daily"]
    if dailies:
        # Find distinct weeks (ISO week)
        weeks = set()
        for p in dailies:
            try:
                ps = dt.datetime.fromisoformat(p["period_start"])
                iso_year, iso_week, _ = ps.date().isocalendar()
                weeks.add((iso_year, iso_week))
            except (KeyError, ValueError):
                continue

        for iso_year, iso_week in sorted(weeks):
            # Sunday of that week
            sun = dt.date.fromisocalendar(iso_year, iso_week, 7)
            target = dt.datetime(sun.year, sun.month, sun.day, 22, 30, tzinfo=HOBART_TZ)
            pid = id_for_post("weekly", target)
            if post_exists(blog_data, pid):
                log(f"backfill: {pid} already exists, skipping")
                continue
            if is_generation_skipped(pid):
                log(f"backfill: {pid} permanently skipped (failure cap / qa_rejected)")
                continue

            log(f"backfill: generating {pid}")
            post = generate_post("weekly", target, blog_data, dry=dry)
            if post:
                post["source"] = "backfill"
                with _blog_lock(BLOG_FILE):
                    fresh = load_blog()
                    if not post_exists(fresh, pid):
                        fresh.setdefault("posts", []).append(post)
                        save_blog(fresh)
                blog_data = load_blog()
                append_blog_log({
                    "ts": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                    "id": post["id"], "type": "weekly", "title": post["title"],
                    "word_count": post["word_count"],
                    "qa_result": post.get("qa_result", "backfill"),
                    "duration_s": post.get("duration_s", 0),
                })
                log(f"backfill: generated weekly: {post['title'][:60]}")
                generated += 1

    log(f"backfill complete: {generated} posts generated")
    return generated


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="SPARK blog daemon")
    parser.add_argument("--dry-run", action="store_true", help="Skip Claude calls and blog writes")
    parser.add_argument("--once", action="store_true", help="Run once and exit")
    parser.add_argument("--backfill", action="store_true", help="Generate all missing posts from history")
    parser.add_argument("--poll-interval", type=int, default=POLL_INTERVAL, help=f"Seconds between schedule checks (default: {POLL_INTERVAL})")
    args = parser.parse_args(argv)

    dry = args.dry_run or os.environ.get("PX_BLOG_DRY", "0") != "0"

    # Single-instance guard (PID file)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    pid_file = STATE_DIR / "px-blog.pid"
    my_pid = os.getpid()
    try:
        if pid_file.exists():
            old_pid = int(pid_file.read_text().strip())
            if old_pid != my_pid and Path(f"/proc/{old_pid}").exists():
                # Verify it's actually a px-blog process, not a recycled PID
                try:
                    cmdline = Path(f"/proc/{old_pid}/cmdline").read_bytes().decode(errors="replace")
                except OSError:
                    cmdline = ""
                if "px-blog" in cmdline:
                    log(f"another px-blog instance is running (pid={old_pid})")
                    return 1
                else:
                    log(f"pid {old_pid} alive but not px-blog (recycled PID) — taking over")
                    pid_file.unlink(missing_ok=True)
            else:
                log(f"stale pid file removed (pid={old_pid})")
                pid_file.unlink(missing_ok=True)
    except (ValueError, OSError) as exc:
        log(f"pid file check failed, removing: {exc}")
        pid_file.unlink(missing_ok=True)
    try:
        fd, tmp = tempfile.mkstemp(dir=pid_file.parent, prefix=".px-blog-pid.")
        try:
            os.write(fd, str(my_pid).encode())
            os.fsync(fd)
        finally:
            os.close(fd)
        os.replace(tmp, str(pid_file))
    except OSError:
        pid_file.write_text(str(my_pid))

    def _safe_unlink_pid():
        try:
            if pid_file.exists() and int(pid_file.read_text().strip()) == my_pid:
                pid_file.unlink(missing_ok=True)
        except (ValueError, OSError):
            pass

    log(f"starting pid={my_pid} dry={dry} once={args.once}")

    if args.backfill:
        count = run_backfill(dry=dry)
        log(f"backfill: {count} posts")
        _safe_unlink_pid()
        return 0

    if args.once:
        count, _skips, _blocked = run_once(dry=dry)
        log(f"generated {count} posts")
        _safe_unlink_pid()
        return 0

    # SIGTERM handler
    _shutdown = threading.Event()

    def _on_signal(s, f):
        _shutdown.set()

    signal.signal(signal.SIGTERM, _on_signal)
    signal.signal(signal.SIGINT, _on_signal)

    try:
        from pxh.model_session import SessionBudgetExhausted as _BudgetError
    except ImportError:
        _BudgetError = None

    SKIP_BACKOFF_S = 300  # 5 min backoff when due posts lack source material

    try:
        while not _shutdown.is_set():
            try:
                count, had_skips, blocked = run_once(dry=dry)
                _health.record_success("px-blog", detail={"generated": count,
                                                          "skipped": bool(had_skips)})
                if count:
                    log(f"poll: generated {count} posts")
                # Freshness: a blog that has not published for N days while
                # eligible source material exists is the failure this daemon
                # cannot see from the inside. It reported `ok` for a month while
                # every day was rejected. See _note_blog_freshness().
                _note_blog_freshness(generated_something=bool(count))
                if had_skips and count == 0:
                    if blocked:
                        # Source material was present; the posts were refused by
                        # the gate or produced nothing. That is a *blocked* blog,
                        # not an idle one — say which, because the two have been
                        # indistinguishable in this log and only one is a bug.
                        log(f"poll: {blocked} due post(s) had source material but were not "
                            f"published (see the reason above) — backing off {SKIP_BACKOFF_S}s")
                    else:
                        log(f"poll: all due posts skipped (missing source material) — backing off {SKIP_BACKOFF_S}s")
                    _shutdown.wait(timeout=SKIP_BACKOFF_S)
                else:
                    _shutdown.wait(timeout=args.poll_interval)
            except Exception as exc:
                if _BudgetError and isinstance(exc, _BudgetError):
                    # Budget exhaustion is the daemon working correctly, not
                    # failing — refusing to spend is its job. Recording it as a
                    # failure would show px-blog red every evening.
                    _health.record_success("px-blog", detail={"throttled": str(exc)[:200]})
                    exc_str = str(exc)
                    import re as _re
                    m = _re.search(r"cooldown \((\d+)s / (\d+)s\)", exc_str)
                    if m:
                        # Per-type cooldown — sleep only until it expires
                        remaining_s = max(60.0, int(m.group(2)) - int(m.group(1)) + 30)
                        log(f"poll: type cooldown — sleeping {int(remaining_s)}s")
                        _shutdown.wait(timeout=remaining_s)
                    else:
                        # Daily cap exhausted — sleep until 5 min past midnight
                        now = dt.datetime.now(HOBART_TZ)
                        midnight = (now + dt.timedelta(days=1)).replace(
                            hour=0, minute=5, second=0, microsecond=0
                        )
                        sleep_s = max(60.0, (midnight - now).total_seconds())
                        log(f"poll: budget exhausted — sleeping {sleep_s / 3600:.1f}h until budget resets")
                        _shutdown.wait(timeout=sleep_s)
                else:
                    log(f"poll: CRASHED: {exc}")
                    _health.record_failure("px-blog", str(exc))
                    _shutdown.wait(timeout=args.poll_interval)
    finally:
        _safe_unlink_pid()
        log("shutting down")

    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
PY
