#!/usr/bin/env bash
# px-brain — supervisor for SPARK's resident Claude sessions.
#
#   bin/px-brain [--once]
#
# Keeps spark-brain (privileged) and spark-io (untrusted input) alive, holds the
# attached tmux client that 3.3a's send-keys requires, sweeps abandoned requests
# on restart, unwedges stuck sessions and recycles context at idle moments.
#
# Watch either session live:
#   tmux -S /tmp/tmux-1000/px-mind attach -t spark-brain   (detach: Ctrl-b d)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/px-env"

ONCE=0
for arg in "$@"; do
    case "$arg" in
        --once) ONCE=1 ;;
        -h|--help) sed -n '2,11p' "$0"; exit 0 ;;
    esac
done

exec /usr/bin/python3 - "$ONCE" <<'PY'
import sys

from pxh import brain_daemon

sys.exit(brain_daemon.run(once=sys.argv[1] == "1"))
PY
