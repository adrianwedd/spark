#!/usr/bin/env bash
# px-card-baseline — one line of numbers to decide a card replacement on (#405).
#
# SD media exposes no lifetime telemetry (`PRE_EOL_INFO` / `DEVICE_LIFE_TIME_*`
# are eMMC EXT_CSD registers), so an A/B replacement test compares *measured*
# numbers instead. Run this on the current card, then on the replacement, under
# the same workload, and compare:
#
#   bin/px-card-baseline            # human line
#   bin/px-card-baseline --json     # same numbers, for a diff
#
# The workload matters: the apt timers (#402) and deploy restarts dominate IO
# variance, so compare like with like (same time of day, no apt run in between).
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/px-env"

exec /usr/bin/python3 - "$@" <<'PY'
"""Summarise the card's measured service time from the observer's records."""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

PROJECT_ROOT = Path(os.environ.get("PROJECT_ROOT", "/home/pi/picar-x-hacking"))
LOG_DIR = Path(os.environ.get("LOG_DIR", PROJECT_ROOT / "logs"))

from pxh import health as _health  # noqa: E402 — px-env exports PYTHONPATH
from pxh import io_attrib  # noqa: E402


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--records", default=str(LOG_DIR / "tool-io-attrib.log"),
                    help="the observer's record log")
    ap.add_argument("--tail", type=int, default=40,
                    help="how many records to summarise (default 40)")
    ap.add_argument("--json", action="store_true", help="machine-readable, for a diff")
    ap.add_argument("--device", default="mmcblk0",
                    help="block device whose identity travels with the numbers")
    ap.add_argument("--state-dir", default=str(PROJECT_ROOT / "state"),
                    help="where px-alive's health record lives (watchdog margin)")
    args = ap.parse_args(argv)

    path = Path(args.records)
    try:
        records = [json.loads(line) for line in path.read_text().splitlines() if line.strip()]
    except FileNotFoundError:
        print(f"px-card-baseline: no records at {path}", file=sys.stderr)
        return 1

    paths = io_attrib.Paths()
    identity = io_attrib.card_identity(paths.sys_block / args.device / "device")
    try:
        margin = _health.read_watchdog_margin(args.state_dir).get("watchdog_margin_min_ms")
    except Exception:  # a missing board must not stop a card comparison
        margin = None

    summary = io_attrib.card_baseline(
        records, tail=max(1, args.tail), identity=identity,
        watchdog_margin_min_ms=margin,
    )
    if args.json:
        print(json.dumps(summary, sort_keys=True))
        return 0

    if not summary["writes_measured"]:
        print(f"px-card-baseline: {summary['records']} record(s), none with writes to measure")
        return 1
    card = summary.get("card") or {}
    if card:
        print(
            "card: {type} {name} manfid {manfid} {date} serial {serial} | {cap} GB".format(
                type=card.get("type", "?"), name=card.get("name", "?"),
                manfid=card.get("manfid", "?"), date=card.get("date", "?"),
                serial=card.get("serial", "?"), cap=card.get("capacity_gb", "?"),
            )
        )
    print(
        "card: ms_per_write median {median} p90 {p90} max {maxv} | "
        "ms_per_read {read} (stall windows, n={reads}) | ext4 errors {errors} | "
        "from {n} record(s), all stall-triggered".format(
            median=summary["ms_per_write_median"], p90=summary["ms_per_write_p90"],
            maxv=summary["ms_per_write_max"],
            read=summary["ms_per_read_median_in_stall_windows"],
            reads=summary["reads_measured"],
            errors=summary["ext4_errors"], n=summary["records"],
        )
    )
    print(
        "      io PSI >=20% at trigger in {inc} of records (median {psi}%) | "
        "watchdog margin {margin} ms".format(
            inc="?" if summary["io_psi_incidence"] is None
            else "{:.0%}".format(summary["io_psi_incidence"]),
            psi=summary["io_psi_median_at_trigger"],
            margin="n/a" if summary["watchdog_margin_min_ms"] is None
            else summary["watchdog_margin_min_ms"],
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
PY
