#!/usr/bin/env bash
# px-deploy-check — list the long-lived units still executing code this deploy changed.
#
# Run on the robot immediately after `git merge --ff-only origin/master`, before
# calling the deploy done.  Source state and process state are separate
# realities: a unit whose entry point still exists but whose *imports* moved
# does not fail at deploy time, it fails hours later inside a lazy import
# (#332).
#
# Exit codes: 0 = every long-lived unit is executing the deployed revision,
#             1 = at least one unit needs a restart, or the host is carrying
#                 staleness from an earlier deploy (#421),
#             2 = cannot tell (no usable revision to diff, or no systemd).
#
# The *first* line is a summary of what needs doing -- restarts and unit-file
# drift -- because the detail lines print after the reassurance, and on
# 2026-09-18 a host with seven drifted unit files (one never installed) exited
# 0 with the drift below the fold. `--strict` widens the exit code from
# "the processes are current" to "nothing needs doing at all".
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/px-env"

exec /usr/bin/python3 - "$@" <<'PY'
"""Report which long-lived px-* units are still executing pre-deploy code.

`pxh.deploy` holds the rule and the reasoning (#332).  This file is only the
host-side plumbing: read the deploy's changed files from git, read the units'
state from systemd, and ask `pxh.deploy` who is stale.
"""

from __future__ import annotations

import argparse
import datetime as dt
import os
import re
import subprocess
import sys

from pxh.deploy import (
    CODE_DIRS,
    UnitState,
    action_summary,
    carried_staleness,
    changed_symbols,
    needs_restart,
    repo_unit_names,
    restart_list,
    unit_file_drift,
)

ENTRY_RE = re.compile(r"(/[^\s;\"']*/(?:bin|systemd)/[^\s;\"']*)")


def sh(args):
    return subprocess.run(args, capture_output=True, text=True, check=True).stdout


def changed_files(root, prev, head):
    out = sh(["git", "diff", "--name-only", prev, head, "--", *CODE_DIRS])
    return [line.strip() for line in out.splitlines() if line.strip()]


def unit_names():
    out = sh(["systemctl", "list-units", "px-*", "--type=service", "--no-legend", "--plain"])
    return sorted({line.split()[0] for line in out.splitlines() if line.strip()})


def unit_state(name):
    exec_start = sh(["systemctl", "show", name, "-p", "ExecStart", "--value"])
    match = ENTRY_RE.search(exec_start)
    started = sh(["systemctl", "show", name, "-p", "ActiveEnterTimestamp", "--value"]).strip()
    started_ts = None
    if started:
        try:
            started_ts = dt.datetime.strptime(started, "%a %Y-%m-%d %H:%M:%S %Z").timestamp()
        except ValueError:
            started_ts = None
    return UnitState(name=name, entry=match.group(1) if match else None, started_ts=started_ts)


def report_unit_drift(root: str) -> list:
    """Collect the installed-vs-repo unit file drift. Prints nothing.

    The other half of "the deployed revision is what runs": the unit files the
    host reads are installed by hand, so a merged unit change is invisible until
    someone installs it. Reported rather than failed -- fixing it needs root, and
    blocking a deploy on a root-only action would teach people to ignore the gate.
    """
    return [d for name in repo_unit_names(root) for d in unit_file_drift(name, root=root)]


def print_unit_drift(drift: list) -> None:
    """The detail, printed after the summary that counts it."""
    if not drift:
        return
    print()
    print("{} installed unit file(s) differ from the repo (no restart fixes this):".format(len(drift)))
    for item in drift:
        print("  {:<13} {:50s} {}".format(item.reason, item.installed_path, item.repo_path))
    print("install them, then daemon-reload - the next restart picks them up:")
    print("  sudo install -m 0644 systemd/*.service /etc/systemd/system/ && sudo systemctl daemon-reload")


def print_carried(carried: list) -> None:
    """The units no deploy delta will ever name (#421).

    Printed *before* any reassurance line, for the same reason the counts moved
    to the top in #406: this is the section a reader who skims will otherwise
    never reach, and it is the one that says the host is not what the checkout
    says.
    """
    if not carried:
        return
    print()
    print("{} long-lived unit(s) started before a file they execute changed on disk "
          "\u2014 carried from an earlier deploy, no restart performed:".format(len(carried)))
    for item in sorted(carried, key=lambda c: c.name):
        print("  {:24s} started {}  newest executed change {}  ({})".format(
            item.name,
            dt.datetime.fromtimestamp(item.started_ts).strftime("%Y-%m-%d %H:%M:%S"),
            dt.datetime.fromtimestamp(item.newest).strftime("%Y-%m-%d %H:%M:%S"),
            ", ".join(item.paths[:2]) + ("\u2026" if len(item.paths) > 2 else ""),
        ))
    print("  restart: sudo systemctl restart " + " ".join(
        item.name.replace(".service", "") for item in sorted(carried, key=lambda c: c.name)))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", default=os.environ.get("PROJECT_ROOT", os.getcwd()))
    parser.add_argument("--prev", default="HEAD@{1}", help="revision deployed from (default: HEAD@{1})")
    parser.add_argument("--head", default="HEAD")
    parser.add_argument(
        "--deploy-stamp",
        default=None,
        help="ISO timestamp of the deploy; used for files the deploy deleted (no mtime on disk)",
    )
    parser.add_argument(
        "--strict",
        action="store_true",
        help="exit 1 if anything needs action (a restart or a unit-file install); "
             "the default exit code describes the processes - which now includes "
             "staleness carried from an earlier deploy (#421)",
    )
    args = parser.parse_args()
    root = os.path.abspath(args.root)

    try:
        moved = changed_files(root, args.prev, args.head)
    except (subprocess.CalledProcessError, FileNotFoundError) as exc:
        print("px-deploy-check: cannot read the deploy diff ({}..{}): {}".format(args.prev, args.head, exc))
        print("  Re-run with an explicit --prev <revision> when the reflog cannot answer.")
        return 2

    # The unit-file report is about the *host*, not about the diff, so it is
    # collected first and its count leads the output: the first version returned
    # before reaching it, and a docs-only deploy therefore reported no drift
    # while five units were months stale (#390).
    drift = report_unit_drift(root)

    try:
        units = [unit_state(name) for name in unit_names()]
    except (subprocess.CalledProcessError, FileNotFoundError) as exc:
        print("px-deploy-check: cannot read unit state: {}".format(exc))
        return 2

    deploy_ts = None
    if args.deploy_stamp:
        deploy_ts = dt.datetime.fromisoformat(args.deploy_stamp).timestamp()

    # Host state, not deploy state (#421). A restart that could not be performed
    # -- no non-interactive grant for that unit, an interrupted deploy -- leaves
    # no trace in HEAD@{1}..HEAD, so a later deploy reports a clean delta over a
    # host that is still running the older module.
    carried = carried_staleness(units, root=root, deploy_ts=deploy_ts)

    if not moved:
        print(action_summary(0, [], drift, carried))
        print("  (nothing under {} changed in {}..{})".format(
            "/".join(CODE_DIRS), args.prev, args.head))
        print_carried(carried)
        print_unit_drift(drift)
        return 1 if (carried or (args.strict and drift)) else 0

    # Per-file symbol diffs, so the restart list is about *reachability* rather
    # than fan-out (#336): a daemon whose only reference to a changed module is a
    # name that did not change gains nothing from a restart, and a fleet restart
    # on a one-file observability change is churn that teaches people to ignore
    # this gate. A file whose change cannot be determined maps to None, which
    # `restart_list` treats as "flag".
    changes = {path: changed_symbols(args.prev, args.head, path, root) for path in moved}

    verdicts = restart_list(moved, units, root=root, deploy_ts=deploy_ts, changes=changes)
    stale = needs_restart(verdicts)

    print(action_summary(len(moved), [v.name for v in stale], drift, carried))
    print("  ({} changed file(s) in {}..{})".format(len(moved), args.prev, args.head))
    for verdict in verdicts:
        mark = "RESTART" if verdict.needs_restart else "ok     "
        print("  {}  {:24s} {}".format(mark, verdict.name, verdict.reason))

    # Order matters: the reassurance may only print when it is true of the whole
    # fleet, and staleness carried from an earlier deploy is part of that
    # (#421). Printing it above this section is how a host with two stale units
    # read as a clean deploy.
    if stale:
        print()
        print("restart these before calling the deploy complete:")
        print("  sudo systemctl restart " + " ".join(v.name.replace(".service", "") for v in stale))
    print_carried(carried)
    if not stale and not carried:
        print("every long-lived unit is executing the deployed revision")

    print_unit_drift(drift)
    if stale or carried:
        return 1
    return 1 if (args.strict and drift) else 0


if __name__ == "__main__":
    sys.exit(main())
PY
