#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

export PROJECT_ROOT
export LOG_DIR="${LOG_DIR:-$PROJECT_ROOT/logs}"

normalize_path_list() {
    local path_list=":$1:"
    local addition=":$2:"
    [[ "$path_list" == *"$addition"* ]]
}

append_path() {
    local current="${1:-}"
    local addition="$2"
    if normalize_path_list "$current" "$addition"; then
        printf "%s" "$current"
    else
        if [[ -z "$current" ]]; then
            printf "%s" "$addition"
        else
            printf "%s:%s" "$addition" "$current"
        fi
    fi
}

PYTHONPATH="$(append_path "${PYTHONPATH:-}" "$PROJECT_ROOT/src")"
PYTHONPATH="$(append_path "$PYTHONPATH" "/home/pi/picar-x")"
export PYTHONPATH

if [[ -d "$PROJECT_ROOT/.venv" && -z "${VIRTUAL_ENV:-}" ]]; then
    # shellcheck disable=SC1091
    source "$PROJECT_ROOT/.venv/bin/activate"
fi

# Read alive_heartbeat.json's `ts` field and print its age in whole seconds,
# or nothing if the file is missing/unreadable/malformed. Only called in the
# (rare) slow-teardown tail below, never on the fast path.
_yield_alive_heartbeat_age_s() {
    local heartbeat_file="$1"
    [[ -f "$heartbeat_file" ]] || return 0
    python3 -c '
import json, sys, time
try:
    with open(sys.argv[1]) as f:
        ts = float(json.load(f)["ts"])
    print(int(time.time() - ts))
except Exception:
    pass
' "$heartbeat_file" 2>/dev/null
}

# "age_s mode" on one line, or nothing if the file is missing/unreadable.
# Used only for the lease_wait fast-path below — the existing staleness
# checks further down keep using the age-only helper unchanged.
_yield_alive_heartbeat_age_and_mode() {
    local heartbeat_file="$1"
    [[ -f "$heartbeat_file" ]] || return 0
    python3 -c '
import json, sys, time
try:
    with open(sys.argv[1]) as f:
        data = json.load(f)
    ts = float(data["ts"])
    print(int(time.time() - ts), data.get("mode", ""))
except Exception:
    pass
' "$heartbeat_file" 2>/dev/null
}

# Signal px-alive to release its Picarx/GPIO handle so a tool can use servos.
# Usage: yield_alive  (call before opening Picarx in any tool script)
yield_alive() {
    local pid_file="$LOG_DIR/px-alive.pid"
    if [[ -f "$pid_file" ]]; then
        local pid
        pid=$(<"$pid_file")
        if [[ -d "/proc/$pid" ]]; then
            # Fast path: px-alive can be legitimately PARKED — holding no
            # GPIO at all — because another process (e.g. a live voice
            # conversation) already holds the GPIO lease. A parked px-alive
            # never exits (it has nothing to tear down), so the process-death
            # check below can never succeed for it; every caller used to wait
            # out the full budget (up to 30s) and report "wedged" even though
            # px-alive's own log said "no GPIO held, nothing to yield" the
            # whole time (#279 — reproduced live: every GPIO tool the brain
            # picked mid-conversation failed this way, in a system prompt
            # that explicitly prefers such tools for expressiveness). px-alive
            # writes mode="lease_wait" into its heartbeat every
            # LEASE_RECHECK_S=2s while parked, so a fresh reading of it is
            # positive, current evidence of "nothing held" — not a guess —
            # and short-circuits before the signal is even sent, mirroring
            # what px-alive's own signal handler independently concludes for
            # a SIGUSR1 that arrives while parked. Any other mode (or a stale
            # / unreadable heartbeat) falls through to the unchanged wait
            # logic below.
            # Resolved once, used by both this fast-path check and phase 2
            # below — same resolution order (explicit override, then the
            # tmpfs copy, then the state-dir fallback), same stale threshold.
            local heartbeat_file="${PX_YIELD_ALIVE_HEARTBEAT_FILE:-}"
            if [[ -z "$heartbeat_file" ]]; then
                heartbeat_file="${PX_ALIVE_HEARTBEAT_DIR:-/run/spark}/alive_heartbeat.json"
                [[ -f "$heartbeat_file" ]] || heartbeat_file="${PX_STATE_DIR:-$PROJECT_ROOT/state}/alive_heartbeat.json"
            fi
            local stale_after_s="${PX_YIELD_ALIVE_HEARTBEAT_STALE_S:-6}"
            local _hb_age_mode
            _hb_age_mode=$(_yield_alive_heartbeat_age_and_mode "$heartbeat_file")
            if [[ -n "$_hb_age_mode" ]]; then
                local _hb_age="${_hb_age_mode%% *}"
                local _hb_mode="${_hb_age_mode#* }"
                if [[ "$_hb_mode" == "lease_wait" && "$_hb_age" =~ ^[0-9]+$ && "$_hb_age" -le "$stale_after_s" ]]; then
                    return 0
                fi
            fi

            # px-alive runs as root; a bare `kill` from a non-root caller
            # (most bin/tool-*, bin/px-* scripts) fails EPERM and is
            # swallowed by `|| true`, so px-alive never sees the signal and
            # every yield silently degrades into the 5s poll timeout below
            # (#250-class regression — confirmed live via tool-perform.log/
            # tool-emote.log: "did not exit within 5s; aborting to protect
            # GPIO exclusivity", dozens of occurrences). `pi` already has
            # passwordless sudo for this host's automation; route through it
            # unconditionally so both root and non-root callers work the
            # same way (sudo to root-signal-root is a harmless no-op).
            sudo -n kill -USR1 "$pid" 2>/dev/null || true

            # Phase 1: fast poll for the common case — px-alive exits
            # cleanly inside the original ~5s budget (gaze animations take
            # 2-3s to settle). PX_YIELD_ALIVE_POLL_ITERS is a test seam
            # only (default 25 * 0.2s = 5s).
            local poll_iters="${PX_YIELD_ALIVE_POLL_ITERS:-25}"
            local i
            for i in $(seq "$poll_iters"); do
                [[ -d "/proc/$pid" ]] || break
                sleep 0.2
            done

            # Phase 2: still alive past the fast window. Camera/GPIO
            # teardown (#261) is now heartbeat-protected against systemd's
            # own watchdog and can legitimately outlast phase 1 (observed
            # live: 8.75s and 14s) — a caller that gives up here on a bare
            # timer either races px-alive for GPIO5 (the pre-#250 bug) or
            # aborts a yield that was seconds from succeeding (#205's
            # remaining gap). Keep waiting only while px-alive is
            # *provably* still working: alive_heartbeat.json must be
            # advancing — px-alive beats it every HEARTBEAT_EVERY_S=2s
            # during teardown via _with_heartbeat(). A stalled heartbeat
            # means wedged, not slow, and fails fast rather than waiting
            # out the full budget. Still bounded overall by
            # PX_YIELD_ALIVE_MAX_WAIT_S so a caller can never hang
            # indefinitely, even against a heartbeat that never stops.
            if [[ -d "/proc/$pid" ]]; then
                # heartbeat_file and stale_after_s already resolved above,
                # for the lease_wait fast-path check.
                # Evidence-based ceiling: ~2x the worst live teardown observed
                # (14s), not the 2-3s gaze-animation figure the original 5s
                # budget was sized against.
                local max_wait_s="${PX_YIELD_ALIVE_MAX_WAIT_S:-30}"
                local fast_window_ds=$(( poll_iters * 2 ))
                local phase2_budget_ds=$(( (max_wait_s * 10) - fast_window_ds ))
                local phase2_iters=$(( phase2_budget_ds > 0 ? phase2_budget_ds / 5 : 0 ))
                local j
                for j in $(seq 0 "$phase2_iters"); do
                    [[ -d "/proc/$pid" ]] || break
                    local age
                    age=$(_yield_alive_heartbeat_age_s "$heartbeat_file")
                    if [[ -z "$age" ]]; then
                        echo "yield_alive: px-alive (PID $pid) did not exit within the fast poll window and no heartbeat evidence is available to prove continued progress; aborting to protect GPIO exclusivity" >&2
                        return 1
                    fi
                    if (( age > stale_after_s )); then
                        echo "yield_alive: px-alive (PID $pid) heartbeat is stale (${age}s, threshold ${stale_after_s}s) — appears wedged mid-teardown, not shutting down; aborting to protect GPIO exclusivity" >&2
                        return 1
                    fi
                    if (( j == phase2_iters )); then
                        echo "yield_alive: px-alive (PID $pid) still shutting down (heartbeat fresh, ${age}s old) after ${max_wait_s}s total; aborting to protect GPIO exclusivity" >&2
                        return 1
                    fi
                    sleep 0.5
                done
            fi

            # If px-alive is still alive here, it did not release GPIO5 —
            # returning success would let the caller race px-alive for the
            # reset_mcu pin (#205). Fail hard instead.
            if [[ -d "/proc/$pid" ]]; then
                echo "yield_alive: px-alive (PID $pid) did not exit; aborting to protect GPIO exclusivity" >&2
                return 1
            fi
            # px.close() does NOT release GPIO5 (reset_mcu pin) — only
            # full process exit does. lgpiod also needs time to reclaim
            # the pin after client fd closes. 2s is empirically safe.
            sleep 2.0
        fi
    fi
}

mkdir -p "$LOG_DIR"

# Default audio output: HifiBerry DAC via robot_hat ALSA plug device.
# Override with e.g. PX_VOICE_DEVICE=plughw:1,0 for direct HW access.
export PX_VOICE_DEVICE="${PX_VOICE_DEVICE:-robothat}"

# PulseAudio socket lives at /run/user/1000/pulse — systemd services run as
# User=pi but don't inherit XDG_RUNTIME_DIR, so aplay -D pulse can't find it.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}"
