#!/usr/bin/env bash
#
# Chirp-train loopback check for the microphone capture path.
#
# Plays short tones through SPARK's own speaker at known intervals while
# recording through ArecordStream, then verifies every chirp came back and the
# recovered timeline is not compressed.
#
# This is the regression test for the PyAudio capture bug: PortAudio's ALSA
# backend silently discarded ~32% of samples on this USB mic, which no offline
# metric on the recorded file could see — but it compressed the chirp timeline
# by seconds and lost 5 of 18 chirps. arecord recovers 18/18 within ~3 ms.
#
# Requires the mic to be free:
#   sudo systemctl stop px-wake-listen && bin/px-mic-check; sudo systemctl start px-wake-listen
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/px-env"

exec "$PROJECT_ROOT/.venv/bin/python3" - "$@" <<'PY'
import argparse
import math
import struct
import subprocess
import sys
import tempfile
import threading
import time
import wave
from pathlib import Path

from pxh.mic_stream import ArecordStream, resolve_arecord_device

RATE = 44100
CHUNK = 2048
CHIRP_S = 0.08
GAP_S = 0.30
FREQ = 3000
# Tolerances. The failing PyAudio path missed 5 of 18 chirps and compressed the
# timeline by seconds; a healthy path lands ~3 ms off, so 20 ms separates the
# two by two orders of magnitude without flagging normal scheduling jitter.
MAX_DEV_MS = 20.0


def enable_amp() -> None:
    """MAX98357A amp is gated on GPIO 20 — aplay exits 0 but is silent without it.

    robot_hat lives in system site-packages, not the venv this script runs
    under, so the subprocess is the normal path (same as px-wake-listen).
    """
    try:
        from robot_hat import enable_speaker
        enable_speaker()
        return
    except ModuleNotFoundError:
        pass
    except Exception as exc:
        print(f"warn: enable_speaker (direct) failed: {exc}")
    try:
        proc = subprocess.run(
            ["/usr/bin/python3", "-c",
             "from robot_hat import enable_speaker; enable_speaker()"],
            capture_output=True, timeout=5, check=False,
        )
        if proc.returncode != 0:
            print(f"warn: enable_speaker subprocess rc={proc.returncode} — "
                  f"continuing; px-alive may already have the amp on")
    except Exception as exc:
        print(f"warn: enable_speaker failed ({exc}) — continuing")


def build_train(n_chirps: int) -> str:
    samples = []
    chirp_n = int(RATE * CHIRP_S)
    gap_n = int(RATE * GAP_S)
    fade = int(RATE * 0.005)  # 5 ms fades so the onset detector sees edges, not clicks
    for _ in range(n_chirps):
        for t in range(chirp_n):
            s = int(22000 * math.sin(2 * math.pi * FREQ * t / RATE))
            if t < fade:
                s = int(s * t / fade)
            elif t > chirp_n - fade:
                s = int(s * (chirp_n - t) / fade)
            samples.append(s)
        samples.extend([0] * gap_n)
    tf = tempfile.NamedTemporaryFile(suffix=".wav", delete=False)
    with wave.open(tf.name, "wb") as wf:
        wf.setnchannels(1)
        wf.setsampwidth(2)
        wf.setframerate(RATE)
        wf.writeframes(struct.pack(f"{len(samples)}h", *samples))
    return tf.name


def _rms(block) -> float:
    if not block:
        return 0.0
    return (sum(s * s for s in block) / len(block)) ** 0.5


def detect_onsets(pcm: bytes) -> list:
    """Onset times (s) of energy bursts, via a hysteresis gate relative to peak."""
    n = len(pcm) // 2
    samples = struct.unpack(f"<{n}h", pcm)
    win = 256
    levels = [_rms(samples[i:i + win]) for i in range(0, n - win, win)]
    if not levels:
        return []
    peak = max(levels)
    hi, lo = peak * 0.35, peak * 0.15
    onsets, active = [], False
    for i, lv in enumerate(levels):
        if not active and lv > hi:
            active = True
            onsets.append(i * win / RATE)
        elif active and lv < lo:
            active = False
    return onsets


def main(argv) -> int:
    ap = argparse.ArgumentParser(description="Microphone capture loopback check")
    ap.add_argument("--chirps", type=int, default=18)
    ap.add_argument("--mic", default="USB",
                    help="Substring to match in the `arecord -l` card description")
    ap.add_argument("--aplay-device", default="pulse")
    args = ap.parse_args(argv)

    enable_amp()
    wav = build_train(args.chirps)
    device = resolve_arecord_device(args.mic)
    print(f"capture device: {device}")

    stream = ArecordStream(device=device, rate=RATE, channels=1,
                           chunk_frames=CHUNK, buffer_s=60.0, log=print)
    stream.start_stream()
    time.sleep(0.5)
    stream.flush()

    captured = []
    stop = threading.Event()

    def reader():
        while not stop.is_set():
            captured.append(stream.read(CHUNK, False))

    t = threading.Thread(target=reader, daemon=True)
    t.start()
    time.sleep(0.3)

    t0 = time.monotonic()
    subprocess.run(["aplay", "-q", "-D", args.aplay_device, wav], check=False)
    play_elapsed = time.monotonic() - t0
    time.sleep(0.4)
    stop.set()
    t.join(timeout=5)
    stream.close()
    Path(wav).unlink(missing_ok=True)

    pcm = b"".join(captured)
    dur = len(pcm) / 2 / RATE
    print(f"played {play_elapsed:.2f}s; captured {dur:.2f}s "
          f"({len(pcm) // 2} frames); dropped_chunks={stream.dropped_chunks}")

    onsets = detect_onsets(pcm)
    print(f"chirps recovered: {len(onsets)}/{args.chirps}")

    expected = CHIRP_S + GAP_S
    max_dev = 0.0
    if len(onsets) >= 2:
        gaps = [b - a for a, b in zip(onsets, onsets[1:])]
        max_dev = max(abs(g - expected) for g in gaps) * 1000
        print(f"expected interval {expected * 1000:.1f} ms; "
              f"mean {sum(gaps) / len(gaps) * 1000:.1f} ms; "
              f"max deviation {max_dev:.1f} ms")

    ok = (len(onsets) == args.chirps
          and stream.dropped_chunks == 0
          and max_dev < MAX_DEV_MS)
    print("RESULT:", "PASS" if ok else "FAIL")
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
PY
