#!/usr/bin/env bash
# px-spark — launch the Claude voice loop as SPARK, the child companion persona.
#
# SPARK (Support Partner for Awareness, Regulation & Kindness) is a warm,
# calm robot companion designed for neurodivergent kids. It uses declarative
# language, connection-before-direction, and meltdown-aware quiet mode.
#
# Usage:
#   bin/px-spark [--dry-run] [--input-mode voice|text] [extra codex-voice-loop args]
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/px-env"

# Short-circuit --help/-h before persona activation or greeting
for arg in "$@"; do
    if [[ "$arg" == "--help" || "$arg" == "-h" ]]; then
        exec "$SCRIPT_DIR/codex-voice-loop" --help
    fi
done

# Activate SPARK persona in session state.
#
# Quiet mode is cleared through the canonical API (#209), not by writing the
# legacy spark_quiet_mode bool directly. A direct bool write is silently
# masked by an authoritative quiet_state record — quiet_mode.migrate_legacy()
# always prefers structured state over the legacy bool — so a raw write here
# would report success while leaving an active Three S's session in place.
python3 - <<'PY'
import os, sys
sys.path.insert(0, os.environ["PROJECT_ROOT"] + "/src")
from pxh.state import clear_quiet_mode, update_session
clear_quiet_mode(source="px_spark", reason="persona_activated")
update_session(fields={"persona": "spark"})
print("[spark] persona activated")
PY

# Test hook (#209): exit right after persona activation, before the greet
# and the exec into codex-voice-loop, so activation is unit-testable without
# needing a real voice backend.
if [[ "${PX_SPARK_ACTIVATE_ONLY:-0}" != "0" ]]; then
    exit 0
fi

# Set SPARK voice environment
export PX_PERSONA=spark
export PX_VOICE_VARIANT=en+m3
export PX_VOICE_PITCH=82
export PX_VOICE_RATE=120

# Use Claude Haiku for SPARK's inner thoughts (much better quality than Ollama small models)
export PX_MIND_BACKEND=claude

# Greet — calm, warm, not performative
python3 - <<'PY'
import os, subprocess
from pathlib import Path
PROJECT_ROOT = Path(os.environ["PROJECT_ROOT"])
subprocess.run(
    [str(PROJECT_ROOT / "bin" / "tool-voice")],
    env={**os.environ, "PX_TEXT": "Hey. I'm here."},
    check=False,
)
PY

# Launch the SPARK voice loop on the cognition tier.
# Voice turns are one direct API call (#317 Phase 3). There is no session to
# hold a system prompt and no mailbox to carry an answer, which is the whole
# point: a spoken sentence cannot be produced and then lost in transit when
# nothing carries it but the socket.
export PX_VOICE_BACKEND=tier

exec "$SCRIPT_DIR/codex-voice-loop" \
    --backend tier \
    --prompt "$SCRIPT_DIR/../docs/prompts/spark-voice-system.md" \
    "$@"
