#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/px-env"

calibrate_cliff=0
dry_run=0
for arg in "$@"; do
    case "$arg" in
        --calibrate-cliff) calibrate_cliff=1 ;;
        --dry-run) dry_run=1 ;;
    esac
done

# Cliff calibration opens the same root-owned GPIO/I2C devices as a wander.
# Make the command printed by the fail-closed gate directly runnable by pi.
if [[ "$calibrate_cliff" == "1" && "$dry_run" == "0" &&
      "${PX_BYPASS_SUDO:-0}" != "1" && "$EUID" -ne 0 ]]; then
    exec sudo -n env \
        "PYTHONPATH=$PYTHONPATH" \
        "PROJECT_ROOT=$PROJECT_ROOT" \
        "LOG_DIR=$LOG_DIR" \
        "PX_STATE_DIR=${PX_STATE_DIR:-$PROJECT_ROOT/state}" \
        "$SCRIPT_DIR/px-wander" "$@"
fi

calibration_guard=0

set_calibration_guard() {
    local active="$1"
    /usr/bin/python3 - "$active" "$$" <<'PY'
import datetime as dt
import sys

from pxh import wander

active = sys.argv[1] == "1"
pid = int(sys.argv[2]) if active else None
started = dt.datetime.now(dt.timezone.utc).isoformat() if active else None
if not wander._write_exploring_state(active, pid=pid, started=started):
    raise SystemExit(1)
PY
}

cleanup_calibration_guard() {
    if [[ "$calibration_guard" == "1" ]]; then
        set_calibration_guard 0 || true
    fi
}

# px-alive is configured to restart after yielding. Calibration used to omit
# this marker, allowing that restart to race Picarx() and reclaim GPIO.
if [[ "$calibrate_cliff" == "1" && "$dry_run" == "0" ]]; then
    set_calibration_guard 1
    calibration_guard=1
    trap cleanup_calibration_guard EXIT INT TERM
fi

yield_alive

/usr/bin/python3 - "$@" <<'PY'
import sys
from pxh.wander import main
raise SystemExit(main(sys.argv[1:]))
PY
