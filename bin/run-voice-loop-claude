#!/usr/bin/env bash
# run-voice-loop-claude — launch the voice loop using Claude Code as the LLM backend.
#
# Usage:
#   bin/run-voice-loop-claude [--input-mode voice|text] [--dry-run] [--auto-log] [...]
#
# All extra arguments are forwarded to voice_loop.py (codex-voice-loop).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/px-env"

# Voice turns run on the resident spark-brain session — the sole permitted
# Claude substrate (see the resident-only invariant in CLAUDE.md). There is no
# bridge to a cold `claude -p` any more: the fossil was deleted rather than
# deprecated, because leaving one executable is how it turns back into
# architecture.
export PX_VOICE_BACKEND=brain

exec "$SCRIPT_DIR/codex-voice-loop" \
    --backend brain \
    --prompt "$SCRIPT_DIR/../docs/prompts/claude-voice-system.md" \
    "$@"
