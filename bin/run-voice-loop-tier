#!/usr/bin/env bash
# run-voice-loop-tier — launch the voice loop on the cognition tier.
#
# Usage:
#   bin/run-voice-loop-tier [--input-mode voice|text] [--dry-run] [--auto-log] [...]
#
# All extra arguments are forwarded to voice_loop.py (codex-voice-loop).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/px-env"

# Voice turns run on the cognition tier: one direct API call, no session, no
# mailbox. This launcher used to point at a resident Claude Code session, and
# was named for it; #317 Phase 3 deleted that session, so the name went with it
# rather than becoming a word for something it no longer describes.
#
# There is no bridge to a cold `claude -p` either — that fossil was deleted
# earlier, and for the same reason: leaving one executable is how it turns back
# into architecture.
export PX_VOICE_BACKEND=tier

exec "$SCRIPT_DIR/codex-voice-loop" \
    --backend tier \
    --prompt "$SCRIPT_DIR/../docs/prompts/voice-system.md" \
    "$@"
