#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/px-env"

python - "$@" <<'PY'
"""Tool wrapper: photograph the scene then describe it using Claude vision."""
from __future__ import annotations

import datetime as dt
import json
import os
import signal
import subprocess
import time
import urllib.request
import urllib.error
from pathlib import Path

from pxh.gpio_lease import GpioLeaseGuard, GpioLeaseStore
from pxh.logging import log_event
from pxh.state import update_session
from pxh.vision import describe_image

PROJECT_ROOT      = Path(os.environ["PROJECT_ROOT"])
STATE_DIR         = Path(os.environ.get("PX_STATE_DIR", str(PROJECT_ROOT / "state")))
TOOL_PHOTOGRAPH   = PROJECT_ROOT / "bin" / "tool-photograph"
TOOL_VOICE        = PROJECT_ROOT / "bin" / "tool-voice"
LOG_DIR           = Path(os.environ.get("LOG_DIR", PROJECT_ROOT / "logs"))

# Frigate API — set PX_FRIGATE_HOST to override (e.g. http://pi5-hailo:5000)
FRIGATE_HOST      = os.environ.get("PX_FRIGATE_HOST", "http://pi5-hailo:5000")
FRIGATE_CAMERA    = os.environ.get("PX_FRIGATE_CAMERA", "picar_x")
FRIGATE_TIMEOUT   = 4  # seconds


def _frigate_latest_jpg(dest: Path) -> bool:
    """Download latest Frigate frame for the camera. Returns True on success."""
    url = f"{FRIGATE_HOST}/api/{FRIGATE_CAMERA}/latest.jpg"
    try:
        with urllib.request.urlopen(url, timeout=FRIGATE_TIMEOUT) as resp:
            if resp.status != 200:
                return False
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_bytes(resp.read())
        return dest.stat().st_size > 0
    except Exception:
        return False


def _stream_pid() -> int | None:
    """Return the running px-frigate-stream PID, or None if not running."""
    pid_file = LOG_DIR / "px-frigate-stream.pid"
    if not pid_file.exists():
        return None
    try:
        pid = int(pid_file.read_text().strip())
        if Path(f"/proc/{pid}").is_dir():
            return pid
    except Exception:
        pass
    return None


def _pause_stream() -> bool:
    """SIGTERM the stream and wait up to 8 s for it to stop. Returns True if stopped."""
    pid = _stream_pid()
    if pid is None:
        return True  # already stopped
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return True
    pid_file = LOG_DIR / "px-frigate-stream.pid"
    for _ in range(16):  # 8 s in 0.5 s steps
        time.sleep(0.5)
        if not pid_file.exists() or _stream_pid() is None:
            return True
    return False  # timed out


def _resume_stream() -> None:
    """Restart px-frigate-stream via systemd (non-blocking)."""
    bypass = os.environ.get("PX_BYPASS_SUDO", "0") == "1"
    cmd = (["bin/px-frigate-stream"] if bypass
           else ["sudo", "-n", "/bin/systemctl", "start", "px-frigate-stream"])
    subprocess.Popen(
        cmd,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        cwd=str(PROJECT_ROOT),
    )

def run_tool(path: Path, extra_env: dict) -> tuple[int, dict]:
    env = os.environ.copy()
    env.update(extra_env)
    result = subprocess.run(
        [str(path)],
        capture_output=True,
        text=True,
        check=False,
        env=env,
    )
    try:
        payload = json.loads(result.stdout.strip().splitlines()[-1])
    except (json.JSONDecodeError, IndexError):
        payload = {"status": "error", "stderr": result.stderr[-256:]}
    return result.returncode, payload


def main() -> int:
    dry_mode = os.environ.get("PX_DRY", "0") != "0"

    if dry_mode:
        description = "A dry-run scene with a robot on a table."
        payload = {
            "status": "ok",
            "path": None,
            "description": description,
            "dry": True,
        }
        log_event("describe_scene", payload)
        update_session(
            fields={"last_action": "tool_describe_scene"},
            history_entry={"event": "describe_scene", "dry": True},
        )
        print(json.dumps(payload))
        return 0

    store = GpioLeaseStore(STATE_DIR)
    inherited_token = os.environ.get("PX_GPIO_LEASE_ID")
    current = store.current()
    borrowed = bool(
        current
        and inherited_token
        and current.get("lease_id") == inherited_token
    )
    gpio_guard = None
    if current and not borrowed:
        print(json.dumps({"status": "error", "error": "GPIO already leased"}))
        return 1
    if not borrowed:
        gpio_guard = GpioLeaseGuard(
            store,
            "describe-scene",
            on_lost=lambda: os.kill(os.getpid(), signal.SIGTERM),
        )
        if not gpio_guard.acquire():
            print(json.dumps({"status": "error", "error": "GPIO already leased"}))
            return 1
    try:
        timestamp = dt.datetime.now().strftime("%Y%m%dT%H%M%S")
        photo_path = PROJECT_ROOT / "photos" / f"{timestamp}.jpg"
        stream_was_running = _stream_pid() is not None
        stream_paused = False

        # Step 1: try Frigate latest frame first (no camera interruption)
        got_photo = _frigate_latest_jpg(photo_path)
        source = "frigate"

        if not got_photo:
            # Step 1b: pause stream and capture directly with rpicam
            if stream_was_running:
                log_event("describe_scene", {"status": "pausing_stream"})
                if not _pause_stream():
                    payload = {"status": "error", "error": "stream did not stop in time"}
                    log_event("describe_scene", payload)
                    print(json.dumps(payload))
                    return 1
                stream_paused = True

            rc_photo, photo_result = run_tool(TOOL_PHOTOGRAPH, {"PX_PHOTO_PATH": str(photo_path)})
            if photo_result.get("status") != "ok":
                if stream_paused:
                    _resume_stream()
                payload = {
                    "status": "error",
                    "error": "photo capture failed",
                    "photo": photo_result,
                }
                log_event("describe_scene", payload)
                print(json.dumps(payload))
                return 1
            source = "rpicam"

        if not photo_path.exists():
            if stream_paused:
                _resume_stream()
            payload = {"status": "error", "error": f"photo file missing: {photo_path}"}
            log_event("describe_scene", payload)
            print(json.dumps(payload))
            return 1

        # Resume stream before the slow Claude vision call
        if stream_paused:
            _resume_stream()
            stream_paused = False

        # Step 2: describe with Claude vision. Drops privileges internally when
        # we are root (wander self-elevates), because root has no credentials.
        description = describe_image(photo_path)

        # Step 3: speak the description
        env = os.environ.copy()
        env["PX_TEXT"] = description[:2000]
        # Bounded, not unbounded: this runs inside wander's DESCRIBE_SCENE_TIMEOUT
        # budget. tool-voice can block indefinitely when the audio device is held
        # by another process, and an unbounded call here means wander kills the
        # whole tool mid-run instead of the tool degrading to a silent but
        # successful scene description. This 60s is the "bounded speech" term in
        # wander.DESCRIBE_SCENE_TIMEOUT's budget; the vision term is
        # vision.CLAUDE_TIMEOUT. Deliberately no totals here — a comment
        # asserting a constant that lives in another file is a test that never
        # runs. The arithmetic is checked by
        # tests/test_wander.py::test_describe_scene_timeout_has_margin_over_claude
        try:
            subprocess.run([str(TOOL_VOICE)], capture_output=True, text=True,
                           check=False, env=env, timeout=60)
        except subprocess.TimeoutExpired:
            pass  # a spoken description is a nicety; the scene record is the point

        payload = {
            "status": "ok",
            "path": str(photo_path),
            "description": description,
            "source": source,
            "dry": False,
        }
        log_event("describe_scene", payload)
        update_session(
            fields={"last_action": "tool_describe_scene"},
            history_entry={"event": "describe_scene", "dry": False, "description": description[:80]},
        )
        print(json.dumps(payload))
        return 0
    finally:
        if gpio_guard is not None:
            gpio_guard.release()


if __name__ == "__main__":
    raise SystemExit(main())
PY
