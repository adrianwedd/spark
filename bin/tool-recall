#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/px-env"

python - "$@" <<'PY'
"""Tool: recall recent notes from state/notes[-persona].jsonl and speak them.

Notes are persona-scoped — SPARK only recalls SPARK notes, VIXEN only VIXEN notes.

This is the one place a durable claim is spoken to a human, so it is also the
one place the claim's provenance must survive into speech (#170). A note SPARK
generated about itself and a note a person told it read identically once they
are prose; saying "I remember: X" for both borrows the authority of perception
for something that may be invention. Every kind gets its own lead-in, and
`unknown` (every pre-#170 note) deliberately claims nothing beyond "I remember".
"""
from __future__ import annotations

import json
import os
import subprocess
from collections import deque
from pathlib import Path

from filelock import FileLock
from pxh import provenance
from pxh.logging import log_event
from pxh.state import load_session, update_session

PROJECT_ROOT = Path(os.environ["PROJECT_ROOT"])
STATE_DIR    = Path(os.environ.get("PX_STATE_DIR", str(PROJECT_ROOT / "state")))

# Spoken lead-in for a single recalled note.
RECALL_LEAD = {
    "observation":  "I remember seeing",
    "report":       "I remember you told me",
    "inference":    "I remember working out",
    "narrative":    "I remember thinking",
    "verification": "I remember checking",
    "unknown":      "I remember",
}

# Per-item lead-in when several notes are recalled at once. One shared
# qualifier would relabel every note with a single kind, so each claim carries
# its own distance. `unknown` renders bare — it has no distance to report.
ITEM_LEAD = {
    "observation":  "I saw",
    "report":       "you told me",
    "inference":    "I worked out",
    "narrative":    "I thought",
    "verification": "I checked",
    "unknown":      "",
}


def notes_file_for_persona(persona: str) -> Path:
    if persona:
        return STATE_DIR / f"notes-{persona}.jsonl"
    return STATE_DIR / "notes.jsonl"


def load_notes(limit: int, notes_file: Path) -> list[dict]:
    """Return whole records, not bare text — the caller needs provenance."""
    if not notes_file.exists():
        return []
    rows: deque[dict] = deque(maxlen=limit)
    lock = FileLock(str(notes_file) + ".lock", timeout=10)
    with lock:
        with notes_file.open("r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    record = json.loads(line)
                    if not isinstance(record, dict) or not record.get("note"):
                        continue
                except json.JSONDecodeError:
                    continue
                rows.append(record)
    return list(rows)


def compose_speech(records: list[dict]) -> str:
    """Render notes for speech without erasing where each one came from."""
    if not records:
        return "I don't have any notes saved yet."
    kinds = [provenance.read_provenance(r)["kind"] for r in records]
    if len(records) == 1:
        lead = RECALL_LEAD.get(kinds[0], RECALL_LEAD["unknown"])
        return f"{lead}: {records[0]['note'][:200]}"
    items = []
    for record, kind in zip(records, kinds):
        # Truncate each note for speech — full text stays in the JSON payload
        short = record["note"][:120]
        lead = ITEM_LEAD.get(kind, "")
        items.append(f"{lead}: {short}" if lead else short)
    return f"I remember {len(records)} things: {'; '.join(items)}."[:500]


def main() -> int:
    dry_mode = os.environ.get("PX_DRY", "0") != "0"
    persona = (load_session().get("persona") or "").lower().strip()
    notes_file = notes_file_for_persona(persona)
    try:
        limit = int(os.environ.get("PX_RECALL_LIMIT", "5"))
        limit = max(1, min(limit, 20))
    except ValueError:
        limit = 5

    records = load_notes(limit, notes_file)
    notes = [r["note"] for r in records]
    spoken = compose_speech(records)

    update_session(
        fields={"last_action": "tool_recall"},
        history_entry={"event": "recall", "count": len(notes)},
    )

    # `notes` stays a list of strings for existing consumers; provenance rides
    # alongside it rather than replacing it (#170 is backwards-compatible).
    payload = {"status": "ok", "dry": dry_mode, "notes": notes, "spoken": spoken,
               "provenance": [provenance.read_provenance(r) for r in records],
               "persona_scope": persona or "shared"}

    if not dry_mode:
        result = subprocess.run(
            [str(PROJECT_ROOT / "bin/tool-voice")],
            env={**os.environ, "PX_TEXT": spoken},
            capture_output=True, text=True, check=False,
        )
        payload["voice_rc"] = result.returncode

    log_event("recall", payload)
    print(json.dumps(payload))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
PY
