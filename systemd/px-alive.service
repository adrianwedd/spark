[Unit]
Description=PiCar-X Idle Alive Daemon (organic servo motion)
After=network.target px-mind.service px-api-server.service
StartLimitIntervalSec=0

[Service]
# Type=notify, not simple: startup and steady state need different deadlines.
# The daemon sends READY=1 only once it is operational (holding the Picarx
# handle, or deliberately not holding it while charging / in I2C backoff), so
# hardware acquisition is governed by TimeoutStartSec below while WatchdogSec
# stays strict for the loop. A start immediately after a yield_alive contends
# for I2C with the tool that just took GPIO and has been observed blocking past
# 15s inside Picarx.__init__ — a healthy daemon killed before it ever ran.
Type=notify
User=root
WorkingDirectory=/home/pi/picar-x-hacking
Environment=HOME=/home/pi
ExecStart=/home/pi/picar-x-hacking/bin/px-alive --no-face
Restart=always
RestartSec=15
NotifyAccess=main
# WatchdogSec is deliberately tight and stays that way: it was doing its job.
# The heartbeat that feeds it now lives on tmpfs (RuntimeDirectory below), so it
# is no longer gated behind SD-card fsync latency that tailed out to 21.5s.
WatchdogSec=15
# Bounds the pre-READY phase. Normal acquisition is ~6s; contention after a
# yield has been seen past 15s. Finite on purpose — a start that never reaches
# READY should fail, not hang. Each pre-READY heartbeat sends
# EXTEND_TIMEOUT_USEC, which is what covers an unbounded park behind a foreign
# GPIO lease without loosening this baseline.
TimeoutStartSec=60
# Creates /run/spark (tmpfs, 0755 root) before ExecStart. Readers run as pi and
# only need the 0755 traverse plus the 0644 files written into it.
RuntimeDirectory=spark
# Preserved across restarts on purpose. /run/spark now holds sonar_live.json as
# well as the heartbeat, and pxh.mind gates that reading on `age < 35` — a
# window explicitly sized to "cover 10s RestartSec + ~6s Picarx acquisition".
# That gate only means anything if the file outlives the restart. With the
# default (no), systemd would delete the directory on every stop and px-mind
# would see "missing" rather than "20s old" through every one of these
# restarts, quietly defeating a deliberately-chosen tolerance.
RuntimeDirectoryPreserve=yes
KillSignal=SIGTERM
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
