[Unit]
Description=SPARK resident Claude session supervisor
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/picar-x-hacking
Environment=HOME=/home/pi
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PATH=/home/pi/.local/bin:/home/pi/picar-x-hacking/.venv/bin:/usr/local/bin:/usr/bin:/bin
# tmux attach refuses to run without a TERM, and systemd provides none. The
# holder client this daemon keeps attached is what makes send-keys work at all
# on tmux 3.3a, so an unset TERM here disables injection entirely — silently,
# and only when nobody is watching.
Environment=TERM=tmux-256color
ExecStart=/home/pi/picar-x-hacking/bin/px-brain
Restart=always
RestartSec=10
# The tmux server and its sessions are deliberately NOT in this unit's cgroup
# lifecycle — killing the supervisor must not kill the brain it supervises. A
# restart re-attaches to the sessions that are already running, which is what
# makes a supervisor restart cheap instead of a cold start for Claude.
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
