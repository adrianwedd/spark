[Unit]
Description=PiCar-X Wake Word Listener (hey spark / hey robot / hey vixen / hey gremlin)
After=network.target sound.target
Wants=sound.target

[Service]
# Type=notify, not simple (#219 item 3): under Type=simple the unit is
# considered "started" the instant it execs, so TimeoutStartSec never
# actually gates model loading — a live incident on 2026-08-23 sat wedged in
# SenseVoice loading (mem_cgroup_handle_over_high, synchronous reclaim under
# MemoryHigh) for 47+ minutes with systemd having no idea anything was wrong.
# Under Type=notify, TimeoutStartSec governs the time until READY=1 arrives
# (bin/px-wake-listen's notify_ready(), called only after STT backend
# selection completes) — a start that never gets there past the deadline is
# killed and handed to Restart=always/RestartSec=10 below, which is this
# unit's existing "fail loudly and retry later" mechanism once the timeout is
# real. 900s is deliberately generous rather than tight: a normal cold start
# (Vosk + SenseVoice, no contention) completes in single-digit seconds, but a
# start racing another process for I2C/memory right after a prior crash
# should still get a real chance before being killed and restarted into the
# same contention. This bounds the failure mode at "restart loop, visible in
# the journal" instead of "silently wedged for hours," which is what #219
# actually needed — it does not by itself make loading faster.
Type=notify
NotifyAccess=main
TimeoutStartSec=900
User=pi
Group=pi
WorkingDirectory=/home/pi/picar-x-hacking
# Creates /run/spark/wake (tmpfs) owned by pi before ExecStart, and removes it
# when the unit stops. The wake grant lives there and nowhere else: it is a
# permission to speak, so it must not survive a reboot or a crash of the only
# daemon allowed to issue one. Deliberately NOT RuntimeDirectoryPreserve — the
# heartbeat next door is preserved because a stale heartbeat reads as stale,
# whereas a stale grant would read as consent. Nested under the existing
# /run/spark rather than beside it; only the final component is owned by this
# unit, so px-alive's directory is untouched.
RuntimeDirectory=spark/wake
Environment=HOME=/home/pi
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
# Wake-triggered conversation runs on the resident spark-brain session, which
# this unit reaches through tmux — not by starting Claude. The PATH below is
# retained rather than trimmed: it was banked from the running unit in #229 and
# still supplies tmux/script, and narrowing it is a separate change with its own
# blast radius. What it no longer needs to supply is ~/.local/bin/claude.
# bin/px-env exports PYTHONPATH but never PATH, so this line is the only thing
# that puts the binary in reach of the unit, and claude lives solely in
# ~/.local/bin (a symlink into ~/.local/share/claude/versions/). Drop the entry
# and the bridge fails its own guard with {"error": "claude not found on PATH"}
# on every summons — deterministically, not intermittently.
Environment=PATH=/home/pi/.local/bin:/home/pi/picar-x-hacking/.venv/bin:/usr/local/bin:/usr/bin:/bin
# Ensure PulseAudio is running (idempotent) and audio hardware is ready
ExecStartPre=/usr/bin/pulseaudio --start
ExecStartPre=/bin/sleep 3
ExecStart=/home/pi/picar-x-hacking/bin/px-wake-listen
# The wake listener is a required always-on sensor: while it is down SPARK
# cannot hear a summons at all, and nothing else reports that. main() returns 0
# on paths that are not failures — notably the PID-file guard losing a startup
# race against a still-live instance, and normal exit from the listen loop — so
# on-failure would leave the robot silently deaf after either. An explicit
# `systemctl stop` still stops it: systemd never restarts a unit that was
# deliberately stopped, under any policy. The cost is a RestartSec loop in the
# genuine duplicate-instance case, which is loud in the journal and strictly
# better than a robot that has quietly stopped listening.
Restart=always
RestartSec=10
# Kill entire process group (bash + python child) on stop
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
