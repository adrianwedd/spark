# picar-x-services — pi's exact-command sudo grants (issues #281, #300).
#
# Source of truth: systemd/sudoers.d/picar-x-services in the repo.
# Install:  sudo visudo -c -f systemd/sudoers.d/picar-x-services \
#           && sudo install -m 0440 -o root -g root \
#              systemd/sudoers.d/picar-x-services /etc/sudoers.d/picar-x-services
#
# Design rule (#281): no rule may take a variable parameter that changes the
# meaning of the command — variable data goes behind a root-owned launcher
# in /usr/local/sbin (px-signal-alive, px-gpio-run) that validates it.
#
# Both path spellings are listed for systemctl and shutdown deliberately
# (#300): /bin and /sbin are symlinks into /usr on Bookworm, but sudo matches
# the resolved command path as a string, and a bare `systemctl` resolves via
# secure_path to /usr/bin/systemctl — the /bin/... spelling alone silently
# broke every bare-spelling caller, including the battery emergency shutdown.

pi ALL=(root) NOPASSWD: /usr/bin/systemctl start px-alive, /usr/bin/systemctl stop px-alive, /usr/bin/systemctl restart px-alive, /bin/systemctl start px-alive, /bin/systemctl stop px-alive, /bin/systemctl restart px-alive
pi ALL=(root) NOPASSWD: /usr/bin/systemctl start px-mind, /usr/bin/systemctl stop px-mind, /usr/bin/systemctl restart px-mind, /bin/systemctl start px-mind, /bin/systemctl stop px-mind, /bin/systemctl restart px-mind
pi ALL=(root) NOPASSWD: /usr/bin/systemctl start px-wake-listen, /usr/bin/systemctl stop px-wake-listen, /usr/bin/systemctl restart px-wake-listen, /bin/systemctl start px-wake-listen, /bin/systemctl stop px-wake-listen, /bin/systemctl restart px-wake-listen
pi ALL=(root) NOPASSWD: /usr/bin/systemctl start px-api-server, /usr/bin/systemctl stop px-api-server, /usr/bin/systemctl restart px-api-server, /bin/systemctl start px-api-server, /bin/systemctl stop px-api-server, /bin/systemctl restart px-api-server
pi ALL=(root) NOPASSWD: /usr/bin/systemctl start px-frigate-stream, /usr/bin/systemctl stop px-frigate-stream, /usr/bin/systemctl restart px-frigate-stream, /bin/systemctl start px-frigate-stream, /bin/systemctl stop px-frigate-stream, /bin/systemctl restart px-frigate-stream

# The remaining long-lived units, so the deploy gate's whole fleet is actionable
# by the agent that reads it (#247/#390). Without these, `px-deploy-check` can
# name a stale unit that nothing but a human can restart — which is the shape
# the gate was built to end. Same exact-command form as the five above: one
# named unit per operation, no wildcard, no unit argument, so no grant here can
# be turned into "restart anything". px-blog is included because it is the
# daemon whose restart deploys a blog fix; px-post, px-evolve and px-tts-glados
# because they are in the same fleet and drift the same way; px-battery-poll
# because it is the unit #247's carried staleness names.
pi ALL=(root) NOPASSWD: /usr/bin/systemctl start px-blog, /usr/bin/systemctl stop px-blog, /usr/bin/systemctl restart px-blog, /bin/systemctl start px-blog, /bin/systemctl stop px-blog, /bin/systemctl restart px-blog
pi ALL=(root) NOPASSWD: /usr/bin/systemctl start px-post, /usr/bin/systemctl stop px-post, /usr/bin/systemctl restart px-post, /bin/systemctl start px-post, /bin/systemctl stop px-post, /bin/systemctl restart px-post
pi ALL=(root) NOPASSWD: /usr/bin/systemctl start px-evolve, /usr/bin/systemctl stop px-evolve, /usr/bin/systemctl restart px-evolve, /bin/systemctl start px-evolve, /bin/systemctl stop px-evolve, /bin/systemctl restart px-evolve
pi ALL=(root) NOPASSWD: /usr/bin/systemctl start px-tts-glados, /usr/bin/systemctl stop px-tts-glados, /usr/bin/systemctl restart px-tts-glados, /bin/systemctl start px-tts-glados, /bin/systemctl stop px-tts-glados, /bin/systemctl restart px-tts-glados
pi ALL=(root) NOPASSWD: /usr/bin/systemctl start px-battery-poll, /usr/bin/systemctl stop px-battery-poll, /usr/bin/systemctl restart px-battery-poll, /bin/systemctl start px-battery-poll, /bin/systemctl stop px-battery-poll, /bin/systemctl restart px-battery-poll

# Unit-file install (#247/#390). Not a wildcard and not a generic shell: the
# launcher takes no argument at all, installs the *unit files this repo tracks*
# from a path it resolves itself, and does one daemon-reload. It validates every
# unit with `systemd-analyze verify` before writing anything, and never restarts
# a unit or touches sudoers. `bin/px-units-install` refuses to do anything else,
# which is why a grant this narrow is enough.
pi ALL=(root) NOPASSWD: /usr/local/sbin/px-units-install

# Root-owned launchers: the arguments each accepts are validated inside the
# launcher itself (px-signal-alive: fixed signal names; px-gpio-run: fixed
# target allowlist + charset-checked lease id; px-research-run: exactly one
# bare v4 uuid).
pi ALL=(root) NOPASSWD: /usr/local/sbin/px-signal-alive USR1, /usr/local/sbin/px-signal-alive TERM
pi ALL=(root) NOPASSWD: /usr/local/sbin/px-gpio-run *

# Delegated research (#281 phase 2). The wildcard here is the one unavoidable
# one: the argument is a uuid, so it cannot be enumerated. The safety is in
# the launcher, not the line — it accepts exactly one argument, requires it to
# be a bare v4 uuid, and builds a fixed systemd-run command from it. This
# grant is live only once the launcher, the worker and /etc/px-research/tier.env
# are installed; see docs/operations/agent-os-isolation-design.md.
pi ALL=(root) NOPASSWD: /usr/local/sbin/px-research-run *

# Battery emergency shutdown (mind.py) and the API's confirmed device actions.
pi ALL=(root) NOPASSWD: /usr/sbin/shutdown -h now, /sbin/shutdown -h now
pi ALL=(root) NOPASSWD: /usr/bin/systemctl reboot, /bin/systemctl reboot
